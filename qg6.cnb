					"source" : "\\begin{dmath*}{} - \\frac{1}{2}F_{{y_{1}} {y_{2}} {y_{3}}} G_{{y_{4}}} c_{{y_{4}}} c_{{y_{1}}} c_{{y_{2}}} b_{{y_{3}}}+\\frac{1}{2}F_{{y_{1}} {y_{2}} {y_{3}}} G_{{y_{4}}} c_{{y_{1}}} c_{{y_{2}}} c_{{y_{4}}} b_{{y_{3}}}+\\frac{1}{4}F_{{y_{1}} {y_{2}} {y_{3}}} F_{{y_{4}} {y_{5}} {y_{1}}} c_{{y_{2}}} c_{{y_{4}}} c_{{y_{5}}} b_{{y_{3}}} - \\frac{1}{4}F_{{y_{1}} {y_{2}} {y_{3}}} F_{{y_{4}} {y_{5}} {y_{2}}} c_{{y_{1}}} c_{{y_{4}}} c_{{y_{5}}} b_{{y_{3}}} - \\frac{1}{4}F_{{y_{1}} {y_{2}} {y_{3}}} F_{{y_{4}} {y_{5}} {y_{6}}} c_{{y_{1}}} c_{{y_{2}}} c_{{y_{4}}} c_{{y_{5}}} b_{{y_{3}}} b_{{y_{6}}}\\end{dmath*}"
