			"source" : "#\\epsilon_{\\alpha \\beta \\mu \\nu}::EpsilonTensor(delta=\\delta^{\\mu}_{\\ \\nu}, metric=g_{\\mu \\nu});\n#\\epsilon^{a b c j}::EpsilonTensor(delta=\\delta^{a}_{b},metric=\\eta_{a b});\n{v^{\\mu?}_{y1},\\pi_{\\mu? y1}}::NonCommuting.\n{e^{\\mu?}_{a? y1},p_{\\mu? y1}^{a?}}::NonCommuting.\n{e_{\\mu? y1}^{a?},p_{\\nu? y1}^{b?}}::NonCommuting.\n{e_{y1},p_{\\mu? y1}^{a?}}::NonCommuting.\n#e::Determinant(e^{\\mu}_{a});\n{e^{\\mu?}_{a? y1},e_{\\mu? y1}^{a?},e_{y1},p_{\\mu? y1}^{a?},v^{\\mu?}_{y1}, \\pi_{\\mu? y1}}::Depends(\\partial{#}, d{#});\n\ng^{\\mu\\nu}::Symmetric;\n{g^{\\mu\\nu},f_{\\mu}^{a}}::Depends(\\partial{#});\n\n{c^{\\mu?}_{y1},b_{\\mu? y1}}::SelfAntiCommuting.\n{G_{\\mu? y1}}::SelfNonCommuting.\n{c^{\\mu?}_{y1}, b_{\\nu? y2}}::NonCommuting.\n{b_{0 y1}, b_{i1 y2}}::NonCommuting.\n{c^{0}_{y1}, c^{i1}_{y2}}::NonCommuting.\n\n\n#F_{y1 y2 y3 \\alpha \\beta}^{\\mu}::TableauSymmetry(shape={1,1}, indices={0,1}).\n\ntest1:= 1111.\ntest2:= 2222.\ntest3:= 3333.\ntest4:= 4444.\ntest5:= 5555.\n#ex:=F_{y1 y2 y3 \\alpha \\beta}^{\\mu}.\n\n#young_project_tensor(ex);\n\n#ex:=G_{\\mu y2}c^{\\mu}_{y2}-F_{y1 \\alpha y2 \\beta y3}^{\\mu}c^{\\alpha}_{y1}c^{\\beta}_{y2}b_{\\mu y3}/2.\nG:=G_{\\mu y1} c^{\\mu}_{y1}-i c^{\\alpha}_{y1} c^{\\beta}_{y2} D_{y1 y3 \\beta} b_{\\alpha y4}S_{y2 y3 y4};\nT:=e^{\\alpha}_{m1 y1} D_{y2 y4 \\alpha} e^{\\beta}_{m2 y4} e_{\\beta y3}^{0} S_{y1 y2 y3 y5}-e^{\\alpha}_{m2 y1} D_{y2 y4 \\alpha} e^{\\beta}_{m1 y4} e_{\\beta y3}^{0} S_{y1 y2 y3 y5};\nP:=p_{\\mu y1}^{m3} e^{\\mu}_{0 y2} S_{y1 y2 y6};\n\nexx:=@(T)@(P)-@(P)@(T);\n\n#ex:= G_{y1} c_{y1} G_{y2} c_{y2}-(1/2)F_{y1 y2 y3} GG_{y3}c_{y1}c_{y2}.\nsubstitute(G,$G_{\\mu y2}c^{\\mu}_{y2}->p_{\\nu y1}^{a}c^{\\mu}_{y2}S_{y1 y2 y3}D_{y3 y4 \\mu}e^{\\nu}_{a y4}-p_{\\nu y1}^{a}e^{\\mu}_{a y2}S_{y1 y2 y3}D_{y3 y4 \\mu}c^{\\nu}_{y4}+\\pi_{\\nu y1}c^{\\mu}_{y2}S_{y1 y2 y3}D_{y3 y4 \\mu}v^{\\nu}_{y4}-\\pi_{\\nu y1}v^{\\mu}_{y2}S_{y1 y2 y3}D_{y3 y4 \\mu}c^{\\nu}_{y4}$,repeat=True);\n\n#split_index(G,$a, 0, m1$, repeat=True)\nsplit_index(G,$\\alpha, 0, i1$, repeat=True);\n\nex2:= v^{i1}_{y1} b_{i1 y1}.\n\n#ex:= @(G)@(ex2)+@(ex2)@(G);\n\nex:=G_{\\mu y1}c^{\\mu}_{y1}G_{\\nu y2}c^{\\nu}_{y2};\n\nsubstitute(ex,$G_{\\mu y2}c^{\\mu}_{y2}->p_{\\nu y1}^{a}c^{\\mu}_{y2}S_{y1 y2 y3}D_{y3 y4 \\mu}e^{\\nu}_{a y4}-p_{\\nu y1}^{a}e^{\\mu}_{a y2}S_{y1 y2 y3}D_{y3 y4 \\mu}c^{\\nu}_{y4}+\\pi_{\\nu y1}c^{\\mu}_{y2}S_{y1 y2 y3}D_{y3 y4 \\mu}v^{\\nu}_{y4}-\\pi_{\\nu y1}v^{\\mu}_{y2}S_{y1 y2 y3}D_{y3 y4 \\mu}c^{\\nu}_{y4}$,repeat=True);\n\n#ex:=b_{i1 y1} c^{0}_{y2} e^{i1}_{0}.\n\n#ee:=c^{\\alpha}_{y1} c^{\\beta}_{y2} D_{y3 y2 \\alpha} G_{\\beta y4} S_{y1 y3 y4}+c^{\\alpha}_{y1} c^{\\beta}_{y2} D_{y3 y4 \\alpha} G_{\\beta y4} S_{y1 y2 y3}.\n\n\n#substitute(ex,$F_{y1 \\alpha y2 \\beta y3}^{\\mu}c^{\\alpha}_{y1}c^{\\beta}_{y2}b_{\\mu y3}-> \\delta{y1 y2 y3} c^{\\alpha}_{y1} c^{\\beta}_{y2} b_{\\alpha y3} p_{\\nu y1}^{a}c^{\\mu}_{y2}\\delta_{y1 y2 y3}D_{y3 y4 \\mu}e^{\\nu}_{a y4}-p_{\\nu y1}^{a}e^{\\mu}_{a y2}\\delta_{y1 y2 y3}D_{y3 y4 \\mu}c^{\\nu}_{y4}$,repeat=True)\ndistribute(ex)\n\n#factor_out(ex,$p_{i1 y1}^{0}$);\n\ndistribute(ex);\n\nsubstitute(ex,$v^{\\mu}_{y1}\\pi_{\\nu y2}->i\\delta^{\\mu}_{\\nu}\\delta_{y1 y2}+\\pi_{\\nu y2}v^{\\mu}_{y1}$,repeat=True)\nsubstitute(ex,$e^{\\mu}_{a y1}p_{\\nu y2}^{b}-> i\\delta^{\\mu}_{\\nu}\\delta^{b}_{a}\\delta_{y1 y2}+p_{\\nu y2}^{b}e^{\\mu}_{a y1}$,repeat=True)\n\ndistribute(ex);\n\nsubstitute(ex,$v^{\\mu}_{y1}\\pi_{\\nu y2}->i\\delta^{\\mu}_{\\nu}\\delta_{y1 y2}+\\pi_{\\nu y2}v^{\\mu}_{y1}$,repeat=True)\nsubstitute(ex,$e^{\\mu}_{a y1}p_{\\nu y2}^{b}-> i\\delta^{\\mu}_{\\nu}\\delta^{b}_{a}\\delta_{y1 y2}+p_{\\nu y2}^{b}e^{\\mu}_{a y1}$,repeat=True)\n\ndistribute(ex);\n\nsubstitute(ex,$v^{\\mu}_{y1}\\pi_{\\nu y2}->i\\delta^{\\mu}_{\\nu}\\delta_{y1 y2}+\\pi_{\\nu y2}v^{\\mu}_{y1}$,repeat=True)\nsubstitute(ex,$e^{\\mu}_{a y1}p_{\\nu y2}^{b}-> i\\delta^{\\mu}_{\\nu}\\delta^{b}_{a}\\delta_{y1 y2}+p_{\\nu y2}^{b}e^{\\mu}_{a y1}$,repeat=True)\