			"source" : "#split_index(t0, $ \\alpha, 0, m $, repeat=True)\n#type( _{a} );\n\nimport sympy as sp\n#from sympy.parsing.sympy_parser import parse_expr\n\n#ZZ=sp.Matrix([[0] * 9 for x1 in range(9)])\nZZ=sp.zeros(9,9)\nlll=\"\"\nz1=0\nNN=0\ny= Ex(str({x for x in range(0,9)}))\n{n1, n#}::Indices(position=independent,values= @(y)).\nZ_{n1 n2}::Metric;\nZ^{n1 n2}::InverseMetric;\nZ::Determinant(Z_{n1 n2});\n\nt0t = t0[2][0]\nt0X = t0[0]\nt0E = t0[1]\ntt0:= (1/4)@(t0)-(1/8)@(t0X)@(t0E)@(t0t)e.\ntt1:=@(t0).\ndistribute(tt0)\nrewrite_indices(tt0, $\\epsilon^{m1 m2}$, $h_{m1 m2}$)\nrewrite_indices(tt0, $X^{m1 m2}$, $h_{m1 m2}$)\nsubstitute(tt0, $h^{m1 m3} h_{m3 m2} -> \\delta^{m1}_{m2}$, repeat=True)\nrename_dummies(tt0)\nsubstitute(tt0,$ X^{m3 m4} -> \\delta_{m8}^{m3} \\delta_{m9}^{m4}, e-> (1/e) $)\n#substitute(tt0,$ \\epsilon^{m3 m4} -> \\delta_{m6}^{m3} \\delta_{m7}^{m4} $)\nsubstitute(tt1,$ X_{m3 m4} -> \\delta^{m8}_{m3} \\delta^{m9}_{m4} $)\n#substitute(tt1,$ \\epsilon_{m3 m4} -> \\delta^{m10}_{m3} \\delta^{m11}_{m4} $)\ntt0:= @(tt0)@(tt1).\n#substitute(tt0,$ \\epsilon_{m3 m4} -> \\delta^{m10}_{m3} \\delta^{m11}_{m4} $)\ndistribute(tt0)\nrename_dummies(tt0);\ndisplay(test2)\nsubstitute(tt0, $ h_{m1 m2} -> \\eta_{m1 m2}, h^{m1 m2} -> \\eta^{m1 m2},(1/e) e -> 1$, repeat=True)\nsubstitute(tt0,$\\eta_{m1 m5} \\eta^{m3 m5}  -> h_{m1}^{m3}, \\eta_{m5 m1} \\eta^{m5 m3} -> h_{m1}^{m3},\\eta_{m5 m1} \\eta^{m3 m5} -> h_{m1}^{m3}, \\eta_{m1 m5} \\eta^{m5 m3} -> h_{m1}^{m3}$,repeat=True)\nsubstitute(tt0, $ h_{m1 m2} -> \\eta_{m1 m2}, h^{m1 m2} -> \\eta^{m1 m2},(1/e) e -> 1$, repeat=True)\nsubstitute(tt0,$\\eta_{m1 m5} \\eta^{m3 m5}  -> h_{m1}^{m3}, \\eta_{m5 m1} \\eta^{m5 m3} -> h_{m1}^{m3},\\eta_{m5 m1} \\eta^{m3 m5} -> h_{m1}^{m3}, \\eta_{m1 m5} \\eta^{m5 m3} -> h_{m1}^{m3}$,repeat=True)\nsubstitute(tt0,$ h_{m1}^{m1} -> 3 $, repeat=True)\nsubstitute(tt0,$ h_{m1}^{m3} -> \\delta_{m1}^{m3} $, repeat=True)\nrename_dummies(tt0);\n\n\n#factor_out(tt0, $  \\epsilon_{m1 m2}, \\epsilon^{m1 m2} $ );\n\n\n\t\t\n\nfor x2 in range(1,4):\n\tfor x3 in range(1,4):\n\t\tz2=0\n\t\tt00:= @(t0).\n\t\tll1 = Ex(\"\\epsilon_{m1 m2} -> \\delta_{m1}^{\"+str(x2)+\"} \\delta_{m2}^{\"+str(x3)+\"}\")\n\t\tsubstitute(t00,$ @(ll1), e -> 1 $) \t\t\t\t\t\t\n\t\tfor x5 in range(1,4):\n\t\t\tfor x6 in range(1,4):\n\t\t\t\tif z2 >= z1:\n\t\t\t\t\t#ll0 = Ex(\"Z_{\"+str(z1)+\" \"+str(z2)+\"}\") \n\t\t\t\t\tt01:= @(t00).\n\t\t\t\t\t#ll1 = Ex(\"X_{m1 m2} -> \\delta_{m1}^{\"+str(x5)+\"} \\delta_{m2}^{\"+str(x6)+\"}\")\n\t\t\t\t\tll1 = Ex(\"\\epsilon^{m3 m4} -> \\delta^{m3}_{\"+str(x5)+\"} \\delta^{m4}_{\"+str(x6)+\"}\")\n\t\t\t\t\tsubstitute(t01,$ @(ll1) $)\n\t\t\t\t\tsubstitute(t01, $ h^{1 1} -> 1, h^{2 2} -> 1, h^{3 3} -> 1 $)\n\t\t\t\t\tsubstitute(t01, $ h_{1 1} -> 1, h_{2 2} -> 1, h_{3 3} -> 1 $)\n\t\t\t\t\t#canonicalise(t01)\n\t\t\t\t\t#display(t01)\n\t\t\t\t\tss=t01._sympy_()\n\t\t\t\t\t#print(ss)\n\t\t\t\t\tif ss == 1000:\n\t\t\t\t\t\tZZ[z1,z2]=ss\n\t\t\t\t\t\t#print(ss)\n\t\t\t\t\t\t#lll=lll+\"Z_{\"+str(z1)+\" \"+str(z2)+\"}=\"+ss+\", \"\n\t\t\t\t\t\tNN+=1\n\t\t\t\t\t\tif z2 != z1:\n\t\t\t\t\t\t\t#lll=lll+\"Z_{\"+str(z2)+\" \"+str(z1)+\"}=\"+ss+\", \"\n\t\t\t\t\t\t\tZZ[z2,z1]=ss\n\t\t\t\t\t\t\tNN+=1\n\t\t\t\tz2+=1\n\t\tz1+=1\n\n#print(ZZ)\n#print(ZZ.eigenvects())\n#t3 = Ex(lll[:-2])\n#t3 = Ex(\"Z_{0 0}=0, Z_{0 1}=2, Z_{1 0}=-2, Z_{1 1}=0\")\n#t3:= Z_{0 0}=0, Z_{0 1}=2, Z_{1 0}=-2, Z_{1 1}=0;\n#complete(t3, $Z$);\n#t4 = t3[NN]\n#display(t4)\n#ttt=Ex(\"Y^{\"+str(x1)+\"}\")\n#tt:= \\delta_{ @(ttt) }^{i1}.\n#ttt:= Y^{ @(tt) i2 i3 i4 i5 i6};\n#display(tt)\n#display(ttt)\n#substitute(t2,$ i1 -> 1 $);\n\n#for x1 in range(4):\n#\tfor x2 in range(x1+1,4):\n#\t\tfor x3 in range(4):\n#\t\t\tz2=0\n#\t\t\tt00:= @(t0).\n#\t\t\tll1 = Ex(\"\\epsilon_{i1 i2 i3} -> \\delta_{i1}^{\"+str(x1)+\"} \\delta_{i2}^{\"+str(x2)+\"} \\delta_{i3}^{\"+str(x3)+\"}\")\n#\t\t\tsubstitute(t00,$ @(ll1), e -> 1/2 $) \t\t\t\t\t\t\n#\t\t\tfor x4 in range(4):\n#\t\t\t\tfor x5 in range(x4+1,4):\n#\t\t\t\t\tf