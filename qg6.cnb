					"source" : "\\begin{dmath*}{} - \\frac{1}{4}{e}^{-1} d{p_{0}\\,^{m1}} e^{i1}\\,_{m2} e^{0}\\,_{m1} p_{i1}\\,^{m2}+\\frac{1}{2}\\eta_{m1 m2} \\eta^{m3 m4} \\partial_{0}{e^{0}\\,_{0}} d{p_{0}\\,^{m1}} e_{0}\\,^{m2} e^{0}\\,_{m3} e^{0}\\,_{m4}+\\frac{1}{2}\\eta_{m1 m2} \\eta^{m3 m4} \\partial_{i1}{e^{0}\\,_{0}} d{p_{0}\\,^{m1}} e^{i1}\\,_{m3} e_{0}\\,^{m2} e^{0}\\,_{m4}+\\frac{1}{2}\\partial_{0}{e^{0}\\,_{0}} d{p_{0}\\,^{m1}} e_{0}\\,^{m2} e^{0}\\,_{m1} e^{0}\\,_{m2}+\\frac{1}{2}\\partial_{i1}{e^{0}\\,_{0}} d{p_{0}\\,^{m1}} e^{i1}\\,_{m1} e_{0}\\,^{m2} e^{0}\\,_{m2}+\\frac{1}{4}{e}^{-1} d{p_{0}\\,^{m1}} e^{i1}\\,_{m1} e^{0}\\,_{m2} p_{i1}\\,^{m2}+\\frac{1}{4}\\eta_{m1 m2} \\eta^{m3 m4} {e}^{-1} d{p_{0}\\,^{m1}} e^{0}\\,_{m3} e^{0}\\,_{m4} p_{0}\\,^{m2}+\\frac{1}{4}\\eta_{m1 m2} \\eta^{m3 m4} {e}^{-1} d{p_{0}\\,^{m1}} e^{i1}\\,_{m3} e^{0}\\,_{m4} p_{i1}\\,^{m2}+\\partial_{0}{e^{0}\\,_{0}} d{p_{0}\\,^{m1}} e^{0}\\,_{m1}+\\partial_{i1}{e^{0}\\,_{0}} d{p_{0}\\,^{m1}} e^{i1}\\,_{m1} - \\frac{2}{9}\\partial_{0}{e^{0}\\,_{m1}} d{p_{0}\\,^{m2}} e_{0}\\,^{m1} e^{0}\\,_{m2} e^{0}\\,_{0} - \\frac{2}{9}\\partial_{0}{e^{i1}\\,_{m1}} d{p_{0}\\,^{m2}} e^{0}\\,_{m2} e_{i1}\\,^{m1} e^{0}\\,_{0} - \\frac{2}{9}\\partial_{i1}{e^{0}\\,_{m1}} d{p_{0}\\,^{m2}} e^{i1}\\,_{m2} e_{0}\\,^{m1} e^{0}\\,_{0} - \\frac{2}{9}\\partial_{i1}{e^{i2}\\,_{m1}} d{p_{0}\\,^{m2}} e^{i1}\\,_{m2} e_{i2}\\,^{m1} e^{0}\\,_{0}+\\frac{2}{9}\\partial_{0}{e^{0}\\,_{m1}} d{p_{0}\\,^{m1}} e_{0}\\,^{m2} e^{0}\\,_{m2} e^{0}\\,_{0}+\\frac{2}{9}\\partial_{i1}{e^{i1}\\,_{m1}} d{p_{0}\\,^{m1}} e^{0}\\,_{0} - \\frac{2}{9}\\eta_{m1 m2} {e}^{-1} d{p_{0}\\,^{m1}} e^{0}\\,_{0} e^{0}\\,_{0} p_{0}\\,^{m2} - \\frac{1}{2}\\eta^{m1 m2} \\omega_{m1 m3} d{p_{0}\\,^{m3}} e^{0}\\,_{m2}+\\frac{1}{2}\\eta^{m1 m2} \\omega_{m3 m1} d{p_{0}\\,^{m3}} e^{0}\\,_{m2}%\n-\\eta_{m1 m2} \\eta^{m3 m4} \\partial_{0}{e^{0}\\,_{m3}} d{p_{0}\\,^{m1}} e_{0}\\,^{m2} e^{0}\\,_{m4} e^{0}\\,_{0}-\\eta_{m1 m2} \\eta^{m3 m4} \\partial_{0}{e^{i1}\\,_{m3}} d{p