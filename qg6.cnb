			"source" : "tt:= @(tp)-p^{m1 m2}\\epsilon_{0 m1 m2}-p^{m1 0}\\epsilon_{0 m1 0};\n\nsubstitute(tt,$\\epsilon_{0 m2 m3}->-\\partial_{\\alpha}{ e^{\\mu}_{m2} } e^{\\alpha}_{0} e_{\\mu}^{m4} h_{m4 m3}$, repeat=True)\nsubstitute(tt,$\\epsilon_{0 m2 0}->+\\partial_{\\alpha}{ e^{\\mu}_{m2} } e^{\\alpha}_{0} e_{\\mu}^{0}$, repeat=True)\n#substitute(tt,$\\epsilon_{0 m2 m3}->-\\epsilon_{0 m2}^{\\mu}  e_{\\mu}^{m4} h_{m4 m3}$,repeat=True)\n#substitute(tt,$\\epsilon_{0 m2 0}->+\\epsilon_{0 m2}^{\\mu}  e_{\\mu}^{0}$,repeat=True)\n\nsubstitute(tt,$\\epsilon_{m1 m2}^{m3}->-\\partial_{\\alpha}{ e^{\\mu}_{m2} } e^{\\alpha}_{m1} e_{\\mu}^{m3}$, repeat=True)\nsubstitute(tt,$\\epsilon_{m1 0}^{m3}->-\\partial_{\\alpha}{ e^{\\mu}_{0} } e^{\\alpha}_{m1} e_{\\mu}^{m3}$, repeat=True)\nsubstitute(tt,$\\epsilon_{m1 m2}^{0}->-\\partial_{\\alpha}{ e^{\\mu}_{m2} } e^{\\alpha}_{m1} e_{\\mu}^{0}$, repeat=True)\nsubstitute(tt,$\\epsilon_{m1 0}^{0}->-\\partial_{\\alpha}{ e^{\\mu}_{0} } e^{\\alpha}_{m1} e_{\\mu}^{0}$, repeat=True)\nsubstitute(tt,$p^{m1 m2}->-p_{\\mu}^{m2} e^{\\mu}_{m3} h^{m3 m1}$, repeat=True)\nsubstitute(tt,$p^{m1 0}->+p_{\\mu}^{m1} e^{\\mu}_{0}$, repeat=True)\n\n#substitute(tt,$\\epsilon_{m1 m2}^{m3}->-\\epsilon_{m1 m2}^{\\mu} e_{\\mu}^{m3}$, repeat=True)\n#substitute(tt,$\\epsilon_{m1 0}^{m3}->-\\epsilon_{m1 0}^{\\mu}e_{\\mu}^{m3}$, repeat=True)\n#substitute(tt,$\\epsilon_{m1 m2}^{0}->-\\epsilon_{m1 m2}^{\\mu} e_{\\mu}^{0}$, repeat=True)\n#substitute(tt,$\\epsilon_{m1 0}^{0}->-\\epsilon_{m1 0}^{\\mu} e_{\\mu}^{0}$, repeat=True)\n#substitute(tt,$p^{m1 m2}->-p_{\\mu}^{m2} e^{\\mu}_{m3} h^{m3 m1}$, repeat=True)\n#substitute(tt,$p^{m1 0}->+p_{\\mu}^{m1} e^{\\mu}_{0}$, repeat=True)\n\nsplit_index(tt,$\\alpha,0,i1$, repeat=True)\ndistribute(tt)\nrename_dummies(tt);\ndisplay(test1)\n\n\ntt:=@(tt)-p_{i1}^{m1} (e^{i2}_{0}\\partial_{i2}{ e^{i1}_{m1} }-e^{i2}_{m1}\\partial_{i2}{ e^{i1}_{0} }-e^{0}_{m1}\\partial_{0}{ e^{i1}_{0} }).\ntt:=@(tt)+p_{i1}^{0} (e^{0}_{0}\\partial_{0}{ e^{i1}_{0} }).\ntt:=@(tt)-p_{0}^{m1} (e^{i2}_{0}\\partial_{i2}{ e^{0}_{m1} }).\n\n\ndistribute(tt)\nrename_dummies(tt);\n\nsubstitute(tt,$h_{m1 m2}->\\eta_{m1 m2},h^{m1 m2}->\\eta^{m1 m2}$, repeat=True)\ndistribute(tt)\nrename_dummies(tt)\n\nsubstitute(tt,$e^{i1}_{0} -> 0, e_{i1}^{0} -> 0$, repeat=True)\nsubstitute(tt,$e_{i1}^{m1} e^{0}_{m1} -> 0$,repeat=True)\nsubstitute(tt,$e_{0}^{m1} e^{i2}_{m1} -> 0$,repeat=True)\nsubstitute(tt,$e_{0}^{0} e^{0}_{0} -> 1$,repeat=True)\nsubstitute(tt,$e_{i1}^{m1} e^{i2}_{m1} -> \\delta_{i1}^{i2}$,repeat=True)\nsubstitute(tt,$e_{i1}^{m1} e^{i1}_{m2} -> \\delta_{m2}^{m1}$,repeat=True)\n\n#substitute(tt,$e^{0}_{m1}->0,e_{0}^{m1}->0$,repeat=True)\n#substitute(tt,$e_{0}^{0} e^{0}_{0}->1$,repeat=True)\n#substitute(tt,$e_{i1}^{m1} e^{i1}_{0}->0$,repeat=True)\n#substitute(tt,$e_{i1}^{0} e^{i1}_{m1}->0$,repeat=True)\nsubstitute(tt,$\\eta_{m1 m2}->h_{m1 m2},\\eta^{m1 m2}->h^{m1 m2}$,repeat=True)\ndistribute(tt)\nrename_dummies(tt)\n#vary(tt, $e^{0}_{m1}->d{e^{0}_{m1}}, e_{0}^{m1}->-e_{0}^{m1}d{e^{0}_{m2}}e_{0}^{m2}, e->-e e_{0}^{m1} d{e^{0}_{m1}}$)\nsubstitute(tt,$\\partial_{0}{ e^{i1}_{0} }->\\epsilon^{i1}$, repeat=True)\n#vary(tt, $\\epsilon^{i1}->d{ \\epsilon^{i1} }, p_{i1}^{0}->d{ e^{i1}_{0} }$)\nvary(tt, $p_{0}^{m1}->d{ p_{0}^{m1} }$)\n\n#vary(tt, $p_{i1}^{0}->d{ p_{i1}^{0} }$)\n#vary(tt, $e^{i1}_{0}->d{ e^{i1}_{0} }, e_{i1}^{0}->-e_{i1}^{0}d{e^{i2}_{0}}e_{i2}^{0}, e->-e e_{i1}^{0} d{e^{i1}_{0}}$)\nsubstitute(tt, $ h_{m1 m2} -> \\eta_{m1 m2}, h^{m1 m2} -> \\eta^{m1 m2}$, repeat=True)\n#substitute(tt,$d{ p_{i1}^{0} }->dd_{i1}$,repeat=True)\n#substitute(tt,$\\partial_{0}{ e^{i1}_{0} }->\\epsilon^{i1}$, repeat=True)\n#substitute(tt,$e^{i1}_{0} -> 0, e_{i1}^{0} -> 0$, repeat=True)\n#substitute(tt,$e^{0}_{m1}->0,e_{0}^{m1}->0$,repeat=True)\n#substitute(tt,$e_{i1}^{m1} e^{i2}_{m1} -> \\delta_{i1}^{i2}$,repeat=True)\n#substitute(tt,$e_{i1}^{m1} e^{i1}_{m2} -> \\delta_{m2}^{m1}$,repeat=True)\n#substitute(tt,$e_{0}^{0} e^{0}_{0} -> 1$,repeat=True)\n#substitute(tt,$e_{i1}^{m1} e^{0}_{m1} -> 0$,repeat=True)\n#substitute(tt,$e_{0}^{m1} e^{i2}_{m1} -> 0$,repeat=True)\ndistribute(tt)\nrename_dummies(tt);\n\n#substitute(tt,$\\partial_{0}{ e^{0}_{m2} }-> \\epsilon_{m2}$, repeat=True)\n#substitute(tt,$\\epsilon_{0 m2 0}->+\\partial_{\\alpha}{ e^{\\mu}_{m2} } e^{\\alpha}_{0} e_{\\mu}^{0}$, repeat=True)\n#substitute(tt,$\\epsilon_{m1 m2}^{m3}->-\\partial_{\\alpha}{ e^{\\mu}_{m2} } e^{\\alpha}_{m1} e_{\\mu}^{m3}$, repeat=True)\n#substitute(tt,$\\epsilon_{m1 0}^{m3}->-\\partial_{\\alpha}{ e^{\\mu}_{0} } e^{\\alpha}_{m1} e_{\\mu}^{m3}$, repeat=True)\n#substitute(tt,$\\epsilon_{m1 m2}^{0}->-\\partial_{\\alpha}{ e^{\\mu}_{m2} } e^{\\alpha}_{m1} e_{\\mu}^{0}$, repeat=True)\n#substitute(tt,$\\epsilon_{m1 0}^{0}->-\\partial_{\\alpha}{ e^{\\mu}_{0} } e^{\\alpha}_{m1} e_{\\mu}^{0}$, repeat=True)\n#substitute(tt,$p^{m1 m2}->-p_{\\mu}^{m2} e^{\\mu}_{m3} h^{m3 m1}$, repeat=True)\n#substitute(tt,$p^{m1 0}->-p_{\\mu}^{0} e^{\\mu}_{m3} h^{m3 m1}$, repeat=True)\n\n#substitute(tt, $ \\eta_{m1 m2} -> h_{m1 m2}, \\eta^{m1 m2} -> h^{m1 m2} $, repeat=True)\n\n\n#substitute(tt,$X_{m1 0}^{0}->-\\partial_{\\alpha}{ e^{\\mu}_{0} } e^{\\alpha}_{m1} e_{\\mu}^{0}$, repeat=True)\n"
