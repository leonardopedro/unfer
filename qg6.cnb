						}
					],
					"source" : "\\begin{dmath*}{}\\frac{1}{24}S_{{y_{1}} {y_{2}} {y_{3}} {y_{4}}}+\\frac{1}{24}S_{{y_{1}} {y_{2}} {y_{4}} {y_{3}}}+\\frac{1}{24}S_{{y_{1}} {y_{3}} {y_{2}} {y_{4}}}+\\frac{1}{24}S_{{y_{1}} {y_{3}} {y_{4}} {y_{2}}}+\\frac{1}{24}S_{{y_{1}} {y_{4}} {y_{2}} {y_{3}}}+\\frac{1}{24}S_{{y_{1}} {y_{4}} {y_{3}} {y_{2}}}+\\frac{1}{24}S_{{y_{2}} {y_{1}} {y_{3}} {y_{4}}}+\\frac{1}{24}S_{{y_{2}} {y_{1}} {y_{4}} {y_{3}}}+\\frac{1}{24}S_{{y_{2}} {y_{3}} {y_{1}} {y_{4}}}+\\frac{1}{24}S_{{y_{2}} {y_{3}} {y_{4}} {y_{1}}}+\\frac{1}{24}S_{{y_{2}} {y_{4}} {y_{1}} {y_{3}}}+\\frac{1}{24}S_{{y_{2}} {y_{4}} {y_{3}} {y_{1}}}+\\frac{1}{24}S_{{y_{3}} {y_{1}} {y_{2}} {y_{4}}}+\\frac{1}{24}S_{{y_{3}} {y_{1}} {y_{4}} {y_{2}}}+\\frac{1}{24}S_{{y_{3}} {y_{2}} {y_{1}} {y_{4}}}+\\frac{1}{24}S_{{y_{3}} {y_{2}} {y_{4}} {y_{1}}}+\\frac{1}{24}S_{{y_{3}} {y_{4}} {y_{1}} {y_{2}}}+\\frac{1}{24}S_{{y_{3}} {y_{4}} {y_{2}} {y_{1}}}+\\frac{1}{24}S_{{y_{4}} {y_{1}} {y_{2}} {y_{3}}}%\n+\\frac{1}{24}S_{{y_{4}} {y_{1}} {y_{3}} {y_{2}}}+\\frac{1}{24}S_{{y_{4}} {y_{2}} {y_{1}} {y_{3}}}+\\frac{1}{24}S_{{y_{4}} {y_{2}} {y_{3}} {y_{1}}}+\\frac{1}{24}S_{{y_{4}} {y_{3}} {y_{1}} {y_{2}}}+\\frac{1}{24}S_{{y_{4}} {y_{3}} {y_{2}} {y_{1}}}\\end{dmath*}"
