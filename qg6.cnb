						}
					],
					"source" : "\\begin{dmath*}{}\\left(\\frac{1}{2}G_{{y_{2}} {y_{5}}}+\\frac{1}{2}F_{{y_{2}} {y_{5}} {y_{3}}} G_{{y_{3}}}\\right) c_{{y_{2}}} c_{{y_{5}}} - \\frac{1}{2}G_{{y_{2}}} c_{{y_{2}}} F_{{y_{4}} {y_{5}} {y_{6}}} c_{{y_{4}}} c_{{y_{5}}} b_{{y_{6}}} - \\frac{1}{2}F_{{y_{1}} {y_{2}} {y_{3}}} c_{{y_{1}}} c_{{y_{2}}} \\left(\\delta_{{y_{3}} {y_{5}}}-c_{{y_{5}}} b_{{y_{3}}}\\right) G_{{y_{5}}}+\\frac{1}{4}F_{{y_{1}} {y_{2}} {y_{3}}} c_{{y_{1}}} c_{{y_{2}}} \\left(\\delta_{{y_{3}} {y_{4}}}-c_{{y_{4}}} b_{{y_{3}}}\\right) F_{{y_{4}} {y_{5}} {y_{6}}} c_{{y_{5}}} b_{{y_{6}}}\\end{dmath*}"
