_{b}$,repeat=True)\ndistribute(ex)\nrename_dummies(ex)\ndisplay(test1)\naction:= @(ex).\n#factor_out(ex, $ e , e^{\\mu}_{a}, \\eta^{a b}, \\eta_{a b}$);\nvary(ex, $e^{\\mu}_{a} -> d{e^{\\mu}_{a}}, e_{\\mu}^{a} -> d{e_{\\mu}^{a}}, e -> d{e} $)\nsubstitute(ex,$d{e} ->  e e^{\\mu}_{a}d{e_{\\mu}^{a}}$,repeat=True)\nsubstitute(ex,$d{e^{\\mu}_{a}} -> -e^{\\nu}_{a} d{e_{\\nu}^{b}} e^{\\mu}_{b}$,repeat=True)\ndisplay(test5)\ndistribute(ex);\nsubstitute(ex, $\\partial_{\\alpha}{d{e_{\\mu}^{a}}} ->\\epsilon_{\\alpha \\mu}^{a}$,repeat=True)\nsubstitute(ex, $d{e_{\\mu}^{a}} -> 0$)\n#substitute(ex,$\\partial_{\\beta}{e^{\\mu}_{a}} -> -e^{\\nu}_{a}\\partial_{\\beta}{e_{\\nu}^{b}} e^{\\mu}_{b}$,repeat=True)\n{h_{a b}, h^{a b}}::Symmetric;\nsubstitute(ex, $ \\eta_{a b} -> h_{a b}, \\eta^{a b} -> h^{a b} $, repeat=True)\nsubstitute(action, $ \\eta_{a b} -> h_{a b}, \\eta^{a b} -> h^{a b} $, repeat=True)\ndistribute(ex)\nrename_dummies(ex)\ndistribute(action)\nrename_dummies(action)\nfactor_out(ex, $ \\epsilon_{\\alpha \\beta}^{a}, e $)\nsubstitute(ex, $ h_{a b} -> \\eta_{a b}, h^{a b} -> \\eta^{a b} $, repeat=True);\nsubstitute(action, $ h_{a b} -> \\eta_{a b}, h^{a b} -> \\eta^{a b} $, repeat=True)\nrename_dummies(action);"
