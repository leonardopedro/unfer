			"source" : "{h_{i1? i2?}, h^{i1? i2?}, h_{i1}^{i2?}}::Diagonal;\ntmp:= @(ex)-@(action).\nt0:= @(ex).\nsubstitute(tmp, $ \\epsilon_{\\alpha \\mu}^{a} -> \\partial_{\\alpha}{ e_{\\mu}^{a} }$, repeat=True)\n#rename_dummies(tmp)\n#distribute(tmp);\n#split_index(tmp, $ \\alpha, 0, m $, repeat=True)\n#split_index(t0, $ \\alpha, 0, m $, repeat=True)\nrename_dummies(tmp)\nrename_dummies(t0)\ndistribute(tmp);\ndistribute(t0);\nsubstitute(t0, $  \\partial_{\\alpha}{ e_{\\mu}^{a} } e^{\\alpha}_{b} e^{\\mu}_{c}-> X_{b c j} \\eta^{j a} $, repeat=True)\nsubstitute(tmp, $  \\partial_{\\alpha}{ e_{\\mu}^{a} } e^{\\alpha}_{b} e^{\\mu}_{c}-> X_{b c j} \\eta^{j a} $, repeat=True)\nsubstitute(t0, $\\epsilon_{\\alpha \\mu}^{a} e^{\\alpha}_{b} e^{\\mu}_{c} -> \\epsilon_{b c j} \\eta^{j a} $, repeat=True)\n#vary(t0, $  f_{m}^{a} -> \\Gamma_{m}^{a} $);\n#substitute(tmp, $  \\partial_{0}{ e_{m}^{a} } -> \\Gamma_{m}^{a} $, repeat=True)\n#substitute(tmp, $  \\Gamma_{m}^{a} \\Gamma_{n}^{b} -> \\Gamma_{m n}^{a b} $, repeat=True)\n\nsubstitute(tmp, $X_{b c a} -> X_{i2 i3 i1} K^{i1}_{a} K^{i2}_{b} K^{i3}_{c}$ , repeat=True)\nsubstitute(tmp,$K_{i1}^{a} K^{i2}_{a} -> \\delta_{i1}^{i2}$,repeat=True)\nsubstitute(t0, $X_{b c a} -> X_{i2 i3 i1} K^{i1}_{a}K^{i2}_{b}K^{i3}_{c}$ , repeat=True)\nsubstitute(t0, $\\epsilon_{b c a} -> \\epsilon_{i2 i3 i1} K^{i1}_{a}K^{i2}_{b}K^{i3}_{c}$ , repeat=True)\n\nsubstitute(t0,$K_{i1}^{a} K^{i2}_{a} -> \\delta_{i1}^{i2}$,repeat=True)\ndistribute(t0);\nrename_dummies(t0);\n#substitute(tmp, $ \\eta_{a b} -> G_{a b}, \\eta^{a b} -> G^{a b} $, repeat=True)\n#rename_dummies(tmp);\n\nsubstitute(tmp, $\\eta_{b c} K_{i2}^{b} K_{i3}^{c} -> h_{i2 i3}$, repeat=True)\nsubstitute(tmp, $\\eta^{b c} K^{i2}_{b} K^{i3}_{c} -> h^{i2 i3}$, repeat=True)\nsubstitute(t0, $\\eta_{b c} K_{i2}^{b} K_{i3}^{c} -> h_{i2 i3}$, repeat=True)\nsubstitute(t0, $\\eta^{b c} K^{i2}_{b} K^{i3}_{c} -> h^{i2 i3}$, repeat=True)\n\n#substitute(tmp, $ \\eta_{a b} -> h_{a b}, \\eta^{a b} -> h^{a b} $, repeat=True)\ndistribute(tmp)\nrename_dummies(tmp);\n\n#substitute(t0, $ \\eta_{a b} -> h_{a b}, \\eta^{a b} -> h^{a b} $, repeat=True)\ndistribute(t0)\nrename_dummies(t0)\n#factor_out(t0, $ \\Gamma_{m}^{a}, \\epsilon_{n}^{b}, e $);\n#factor_out(tmp, $ \\Gamma_{m n}^{a b}, e  $)\n#vary(tmp, $  \\Gamma_{m n}^{a b}  -> \\Gamma_{m}^{a} \\Gamma_{n}^{b} $);\n#substitute(tmp, $\\Gamma_{m}^{a} e^{m}_{c} e^{0}_{j} -> \\Gamma_{j c}^{a} $, repeat=True)\n#substitute(t0, $\\Gamma_{m}^{a} e^{m}_{c} e^{0}_{j} -> \\Gamma_{j c}^{a} $, repeat=True)\n#substitute(t0, $\\epsilon_{m}^{a} e^{m}_{c} e^{0}_{j} -> \\epsilon_{j c}^{a} $, repeat=True)\n#rewrite_indices(tmp, $\\Gamma_{i1 i2}^{a}$, $K_{b}^{i3}$)\n#rewrite_indices(tmp, $\\Gamma_{i1 i2}^{i3}$, $K^{b}_{i4}$)\n\t\nfactor_out(t0, $ e, X_{i1 i2 i3}, \\epsilon_{i4 i5 i6} $)\n\nsubstitute(tmp, $  X_{i1 i2 i3} X_{i4 i5 i6} -> X_{i1 i2 i3 i4 i5 i6} $, repeat=True)\ndistribute(tmp)\nrename_dummies(tmp)\nfactor_out(tmp, $  X_{i1 i2 i3 i4 i5 i6} , e $ )\nsubstitute(tmp, $  X_{i1 i2 i3 i4 i5 i6} -> X_{i1 i2 i3} X_{i4 i5 i6} $, repeat=True)\n#split_index(tmp, $ a, 0, i1 $, repeat=True)\n#split_index(t0, $ a, 0, i1 $, repeat=True)\n#distribute(tmp)\nrename_dummies(tmp);\n#distribute(t0)\nrename_dummies(t0);\nsubstitute(tmp, $ h_{i1 i2} -> \\eta_{i1 i2}, h^{i1 i2} -> \\eta^{i1 i2} $, repeat=True)\n#substitute(tmp, $ h_{0 0} -> -1, h^{0 0} -> -1, h_{0 i1} -> 0,  h^{0 i1} -> 0, h^{i1 0} -> 0, h_{i1 i2} -> \\delta_{i1 i2} $, repeat=True)\n#substitute(t0, $ h_{0 0} -> -1, h^{0 0} -> -1, h_{0 i1} -> 0,  h^{0 i1} -> 0, h^{i1 0} -> 0, h_{i1 i2} -> \\delta_{i1 i2} $, repeat=True)\n#substitute(t0, $ \\eta_{0 0} -> -1, \\eta^{0 0} -> -1, \\eta_{0 i1} -> 0,  \\eta^{0 i1} -> 0, \\eta^{i1 0} -> 0, \\eta_{i1 i2} -> \\delta_{i1 i2} $, repeat=True)\nrename_dummies(tmp);\nrename_dummies(t0);\n\n\ndisplay(test1)\t\n\nt2:= Y^{i1 i2 i3 i4 i5 i6}.\nt1:= Y^{i1 i2 i3 i4 i5 i6}+Y^{i3 i1 i2 i4 i5 i6}.\natmp = t0[2]\nsubstitute(t1,$ Y^{i1 i2 i3 i4 i5 i6} -> @( atmp ) $)\nren