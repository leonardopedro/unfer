# Generated by Cargo
# will have compiled files and executables
debug
target

# Nix build output symlink (P11.23, `nix build .#unfer-ffi`)
result
# F3/F7 (2026-10-13): `nix build -o result-N` symlinks — `result-1` (the piper
# voice model) sat untracked in `git status` because only the bare `result` was
# ignored. Ignore the whole numbered class, not one instance.
result-*

# Austral compiler debug artifacts (regenerated by demo_module/run_demo.sh)
calltree.html
error.html

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Stray LaTeX scratch files (Kopperman tutorial, etc.)
Kopperman_Tutorial.p.tex
*.p.tex

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/
book.pdf
repomix-output.xml
lopez99.md
Hashimoto.md
hashing.md
zk.md

WavefunctionFlows_files/
WavefunctionFlows.html

# QFM-Text training checkpoints (regenerable; too large for git, >100 MB
# each, would exceed GitHub's 100 MB per-file limit)
qfm_text_runs/**/*.qfm

# Lean compiled artifacts (regenerated by `lean -o ...`)
*.olean
.lake/
**/.lake/

# Heavy-test run logs are ephemeral; keep only the cited ALL-GREEN evidence log
# and the PCNL gate logs cited by docs/PCNL_STATUS.md (`/tmp` is not durable —
# it was cleared mid-session on 2026-11-24, taking several cited logs with it).
logs/*
!logs/heavy_tests_20260823_201105.log
!logs/pcnl_r13_gates/
!logs/pcnl_r13_gates/**
!logs/pcnl_r14_gates/
!logs/pcnl_r14_gates/**

# Python bytecode caches (X5 build-artifact hygiene): regenerated on every run.
__pycache__/
*.pyc
quasi_rh_proof.ndjson
