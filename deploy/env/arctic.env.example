# arctic environment. Copy to /etc/arctic/arctic.env, chmod 600, own by root.
#
# All optional; the built-in defaults are in ../docs/RUNBOOK.md and are also
# reported by `GET /version`.
#
# ── Networking / identity ────────────────────────────────────────────────────
# Omit to bind the default. Bind 127.0.0.1 if a reverse proxy terminates TLS in
# front — arctic speaks plain HTTP and has no TLS of its own.
# ARCTIC_BIND_ADDR=0.0.0.0:3000

# The domain in the did:web document. Omit to use the built-in placeholder, which
# will mint a DID for a domain you do not control.
# ARCTIC_DOMAIN=authority.yourdomain.com

# ── Threshold configuration ──────────────────────────────────────────────────
# How many shares a delegation needs. This is the security parameter: raising it
# above total_nodes makes every delegation unfillable, and lowering it to 1 makes
# the authority a single signature.
# ARCTIC_THRESHOLD=3
# ARCTIC_TOTAL_NODES=7

# ── Master key ───────────────────────────────────────────────────────────────
# NOT here. See DEPLOY.md "Secrets": the master public key is not secret, but the
# *signing* key that corresponds to it is, and a key in an env file is a key in
# `systemctl show`.
