#!/usr/bin/env python3
"""OpenAI-shaped /chat/completions endpoint that defers to an out-of-band model.

Saves each incoming request to /tmp/llm/req.json, drops req.ready, then blocks
until /tmp/llm/ans.json appears and serves that verbatim as the model's reply.
This lets an agent (Buffy) read the *real* pipeline prompt and answer it from
outside the process, i.e. play the role of the LLM behind logos' --llm seam.
"""
import http.server
import os
import sys
import time

STATE = "/tmp/llm"
PORT = 8100


class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        sys.stderr.write("[proxy] %s\n" % (fmt % args))
        sys.stderr.flush()

    def _reply(self, code, body, ctype="application/json"):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self):
        if not self.path.rstrip("/").endswith("/chat/completions"):
            self._reply(404, b'{"error":"unknown path"}')
            return
        n = int(self.headers.get("Content-Length", 0))
        req = self.rfile.read(n)
        with open(os.path.join(STATE, "req.json"), "wb") as f:
            f.write(req)
        open(os.path.join(STATE, "req.ready"), "w").close()
        sys.stderr.write("[proxy] request stored, waiting for ans.json\n")
        sys.stderr.flush()

        ans = os.path.join(STATE, "ans.json")
        deadline = time.time() + 600
        while time.time() < deadline:
            if os.path.exists(ans):
                time.sleep(0.05)  # let the writer finish flushing
                with open(ans, "rb") as f:
                    body = f.read()
                os.remove(ans)
                os.remove(os.path.join(STATE, "req.ready"))
                self._reply(200, body)
                return
            time.sleep(0.2)
        self._reply(504, b'{"error":"model never answered"}')

    def do_GET(self):
        self._reply(200, b'{"ok":true}')


if __name__ == "__main__":
    os.makedirs(STATE, exist_ok=True)
    srv = http.server.ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    sys.stderr.write("[proxy] listening on 127.0.0.1:%d\n" % PORT)
    sys.stderr.flush()
    srv.serve_forever()
