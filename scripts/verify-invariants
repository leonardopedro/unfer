#!/usr/bin/env bash
# H1 verify-invariants gate (unfer).
#
# Turns the AGENTS.md maintenance checklist into machine-checkable invariants.
# Each gate checks an OWNED RELATIONSHIP (the repo's own code/census), never a
# sibling repo's service presence. Output lists every executed item; exit code
# is non-zero if any gate FAILS. Explained gaps print [gap] (known, documented
# non-enforcement) and do not fail the gate.

set -u
FAILED=0
PASSED=0
GAPS=0

check() {
    local name="$1"
    shift
    if "$@"; then
        echo "[pass] $name"
        PASSED=$((PASSED + 1))
    else
        echo "[FAIL] $name"
        FAILED=$((FAILED + 1))
    fi
}

gap() {
    echo "[gap]  $1"
    GAPS=$((GAPS + 1))
}

repo_root="$(cd "$(dirname "$0")/.." && pwd)"

# --- H1.1 Quadratic ordering: compile_expression strips zero-point scalars ---
# cas.rs must (a) call apply_quadratic_ordering, (b) drop empty h_term (pure
# scalar), (c) normal_order_inner the ladder strings and drop the zero-point.
check "QO: apply_quadratic_ordering invoked in compile path" \
    grep -q "apply_quadratic_ordering();" "$repo_root/nested_fock_algebra/src/cas.rs"
check "QO: pure scalar terms dropped (empty op list)" \
    grep -q "h_term.1.is_empty()" "$repo_root/nested_fock_algebra/src/cas.rs"
check "QO: normal_order_inner drops [a,a†]=1 zero-point" \
    grep -q "fn normal_order_inner" "$repo_root/nested_fock_algebra/src/cas.rs"

# --- H1.2 LaTeX mapping: dagger -> creation, bare symbol -> annihilation ---
check "LaTeX: dagger/dag/† maps to creation" \
    grep -q 'dagger\|dag' "$repo_root/nested_fock_algebra/src/latex.rs"
check "LaTeX: map_to_creation present" \
    grep -q "fn map_to_creation" "$repo_root/nested_fock_algebra/src/latex.rs"

# --- H1.3 Commutator validation: no reordering via .simplify() ---
# The CAS contract: only .expand(), never .simplify(), where operator order
# matters. (normal_order_inner IS the deliberate, documented reordering.)
# We exclude comment lines, which may *mention* the forbidden call.
check "Commutator: no .simplify() call in cas.rs" \
    bash -c "test -z \"\$(grep -n '\.simplify()' '$repo_root/nested_fock_algebra/src/cas.rs' | grep -v '//')\""

# --- H1.4 GrantSet is_subset_of denies Mutate->Observe relabeling (S21) ---
check "S21: is_subset_of present" \
    grep -q "fn is_subset_of" "$repo_root/unfer_protocol/src/types.rs"
check "S21: is_subset_of checks effect-kind relabel (Mutate->Observe denied)" \
    grep -q "effect_kind_of(&g.name)" "$repo_root/unfer_protocol/src/types.rs"

# --- H1.5 S22 admin refuse list: grants/auth/storage/backend never patchable ---
check "S22: HARD_KEYS refuse list present in admin.rs" \
    grep -q 'HARD_KEYS' "$repo_root/unfer_edge/src/admin.rs"
check "S22: HARD_KEYS contains grants, auth, storage, backend" \
    grep -q '"grants".*"auth".*"storage".*"backend"' "$repo_root/unfer_edge/src/admin.rs"
check "S22: refusal leaves soft config byte-identical" \
    grep -q "soft_config_unchanged" "$repo_root/unfer_edge/src/admin.rs"

# --- H1.6 S23 sanitize_sensitive covers secret-plausible fields ---
check "S23: sanitize_sensitive present" \
    grep -q "fn sanitize_sensitive" "$repo_root/unfer_ffi/src/handles.rs"
check "S23: SENSITIVE_FRAGMENTS includes api_key/token/secret" \
    grep -q 'api_key' "$repo_root/unfer_ffi/src/handles.rs"
check "S23: uk_report_issue is a no-op unless ERROR_REPORT_BINDING provisioned" \
    grep -q "ERROR_REPORT_BINDING" "$repo_root/unfer_ffi/src/lib.rs"

# --- H1.7 Vacuum initialization ---
# Documented invariant: QuantumState::vacuum() has >=1 empty inner universe
# (OuterBosonCreate(InnerBosonicState::vacuum())). The implementation currently
# returns OuterState::vacuum() with an EMPTY bosonic map (0 universes); the
# test at lib.rs:573-578 documents this known non-enforcement.
if grep -q "bosonic: BTreeMap::new()" "$repo_root/nested_fock_algebra/src/lib.rs"; then
    gap "Vacuum: QuantumState::vacuum() lacks the documented empty inner universe (known non-enforcement, see nested_fock_algebra/src/lib.rs vacuum_initialization_single_component test)"
else
    check "Vacuum: QuantumState::vacuum() has >=1 empty inner universe" \
        grep -q "InnerBosonicState::vacuum" "$repo_root/nested_fock_algebra/src/lib.rs"
fi

# --- H1.8 S26 sensitive latch: sensitive observation latches caller set ---
check "S26: SENSITIVE_LATCH store present" \
    grep -q "SENSITIVE_LATCH" "$repo_root/unfer_ffi/src/handles.rs"
check "S26: UK-4701 SENSITIVE_LATCHED code exists" \
    grep -q "SENSITIVE_LATCHED" "$repo_root/unfer_protocol/src/codes.rs"
check "S26: refusal codes wired into loopback consult API" \
    grep -q "uk_is_sensitive_latched" "$repo_root/unfer_ffi/src/lib.rs"

# --- H1.9 S25 meter: single denial point with UTC-day window ---
check "S25: meter_consume is the single denial point" \
    grep -q "fn meter_consume" "$repo_root/unfer_ffi/src/handles.rs"
check "S25: UTC-day window key" \
    grep -q "fn utc_day_key" "$repo_root/unfer_ffi/src/handles.rs"
check "S25: UK-4601/UK-4602 codes exist" \
    grep -q "RATE_LIMITED" "$repo_root/unfer_protocol/src/codes.rs" \
    && grep -q "BUDGET_EXCEEDED" "$repo_root/unfer_protocol/src/codes.rs"
check "S25: uk_meter_status is read-only consult" \
    grep -q "uk_meter_status" "$repo_root/unfer_ffi/src/lib.rs"

# --- H1.10 S29 KernelEvent matchers cover every variant in handles.rs ---
check "S29: matches_query event-type matchers present" \
    grep -q "fn matches_query" "$repo_root/unfer_ffi/src/handles.rs"
check "S29: evolved/conditioned/observed matcher arms present" \
    grep -q '"evolved"' "$repo_root/unfer_ffi/src/handles.rs" \
    && grep -q '"conditioned"' "$repo_root/unfer_ffi/src/handles.rs" \
    && grep -q '"observed"' "$repo_root/unfer_ffi/src/handles.rs"

# --- H1.11 S27 vault: secrets never serialize into snapshots/blueprints ---
check "S27: snapshot refuses live secrets" \
    grep -q "snapshot_refuses_live_secret" "$repo_root/unfer_ffi/src/lib.rs"
check "S27: uk_snapshot enforces the refusal" \
    grep -q "snapshot_refuses_live_secret" "$repo_root/unfer_ffi/src/lib.rs"

# --- H1.12 Symbol census files present (H2 will make them generated) ---
check "S29: EXPECTED_SYMBOLS.txt present" \
    test -s "$repo_root/unfer_ffi/EXPECTED_SYMBOLS.txt"
check "S29: generated C header present" \
    test -s "$repo_root/unfer_ffi/include/unfer_kernel.h"

echo
echo "verify-invariants: $PASSED passed, $GAPS explained gap(s), $FAILED failed"
if [ "$FAILED" -gt 0 ]; then
    exit 1
fi
exit 0