#!/usr/bin/env bash
# Check the phi4 momentum suite on a target other than the host's own.
#
# `coords_inner_product` dispatches to the NEON kernel only on aarch64 and keeps
# the scalar loop as the fallback everywhere else, so a plain `cargo test` on
# either architecture executes exactly one of the two. CI runs on x86_64, which
# is why the aarch64/NEON half of the kernel was never covered there at all:
# this script cross-compiles the suite for a named target and runs it under
# qemu's user-mode emulation, where the other implementation is the code that
# runs. The suite includes `recorded_cutoff_sweep_matches_the_live_model`, which
# recomputes the live C = 12 cell and compares it against the checked-in record
# at 1e-12, so a kernel that disagrees with the record fails rather than merely
# running.
#
#   scripts/check-phi4-cross-target                 # x86_64 (the scalar loop)
#   PHI4_TARGET=aarch64-unknown-linux-gnu \
#   PHI4_CROSS_CC=aarch64-linux-gnu-gcc \
#   PHI4_CROSS_QEMU=qemu-aarch64 \
#   PHI4_CROSS_SYSROOT=/usr/aarch64-linux-gnu \
#     scripts/check-phi4-cross-target               # the NEON kernel
#
# What it does not prove: the digits of a cross build are a function of that
# toolchain, not only of the architecture. The fallback reproduces the record's
# tails bit-for-bit and its Krylov counts exactly (6/19/43 at C = 4/8/12), while
# the m = 4 inside-window errors agree to ~1e-15 relative rather than to the bit.
# See docs/VERIFY_PHI4_MOMENTUM.md, section 5.12.
#
# Requires: a rustup (or nix) toolchain with the target installed, plus a cross
# C compiler, sysroot and qemu for it. Override any of them with the env vars
# above; without them the script resolves them from nix.
set -euo pipefail
repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"

target="${PHI4_TARGET:-x86_64-unknown-linux-gnu}"
target_upper="$(printf '%s' "$target" | tr 'a-z-' 'A-Z_')"

# nix attribute names and the qemu binary that runs this target's executables.
case "$target" in
    x86_64-*) cross_attr=pkgsCross.gnu64; qemu_name=qemu-x86_64 ;;
    aarch64-*) cross_attr=pkgsCross.aarch64-multiplatform; qemu_name=qemu-aarch64 ;;
    *)
        echo "no nix defaults for target $target; set PHI4_CROSS_CC, PHI4_CROSS_QEMU and PHI4_CROSS_SYSROOT" >&2
        exit 69
        ;;
esac

resolve_nix() {
    local attr="$1"
    # `nix build` realises the outputs (a multi-output derivation prints several
    # paths); `nix eval` then names the one the attribute resolves to.
    nix build --no-link "nixpkgs#$attr" >/dev/null 2>&1 || true
    nix eval --raw "nixpkgs#$attr"
}

if [ -z "${PHI4_CROSS_CC:-}" ] || [ -z "${PHI4_CROSS_QEMU:-}" ] || [ -z "${PHI4_CROSS_SYSROOT:-}" ]; then
    if ! command -v nix >/dev/null 2>&1; then
        echo "nix required to provide the $target cross linker, sysroot and qemu;" >&2
        echo "set PHI4_CROSS_CC, PHI4_CROSS_QEMU and PHI4_CROSS_SYSROOT to supply them." >&2
        exit 69
    fi
    PHI4_CROSS_CC="${PHI4_CROSS_CC:-$(resolve_nix "$cross_attr.stdenv.cc")/bin/${target}-cc}"
    PHI4_CROSS_QEMU="${PHI4_CROSS_QEMU:-$(resolve_nix qemu)/bin/${qemu_name}}"
    PHI4_CROSS_SYSROOT="${PHI4_CROSS_SYSROOT:-$(resolve_nix "$cross_attr.glibc")}"
fi

if [ ! -x "$PHI4_CROSS_CC" ] || [ ! -x "$PHI4_CROSS_QEMU" ] || [ ! -d "$PHI4_CROSS_SYSROOT" ]; then
    echo "cross toolchain, qemu or sysroot not found:" >&2
    echo "  cc=$PHI4_CROSS_CC" >&2
    echo "  qemu=$PHI4_CROSS_QEMU" >&2
    echo "  sysroot=$PHI4_CROSS_SYSROOT" >&2
    exit 69
fi

if command -v rustup >/dev/null 2>&1 &&
    ! rustup target list --installed | grep -qx "$target"; then
    echo "missing rust target $target:" >&2
    echo "  rustup target add $target" >&2
    exit 69
fi

# env::var style names cargo reads for a cross linker, e.g.
# CC_AARCH64_UNKNOWN_LINUX_GNU / CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER.
export "CC_$(printf '%s' "$target" | tr '-' '_')"="$PHI4_CROSS_CC"
export "CARGO_TARGET_${target_upper}_LINKER"="$PHI4_CROSS_CC"

# The host triple picks the same kernel the plain `cargo test` already ran, so
# such a run only varies the toolchain and link path. That is still a real check
# (CI's x86_64 leg exists for exactly that) but it is not what this script is
# for, and a green result there must not be read as covering the other kernel.
host="$(rustc -vV | sed -n 's/^host: //p')"
if [ "$target" = "$host" ]; then
    echo "note: $target is the host triple, so this run repeats the host's kernel" >&2
    echo "      through a second toolchain; it does not cover the other implementation." >&2
fi

echo "== building tests/phi4_momentum_sirk for $target" >&2
# Ask for the artifact stream: cargo prints `Executable ...` only when it actually
# links, so a cached build would leave the path unknown.
if ! build_json="$(cargo test -p fock_sirk --release --target "$target" \
    --test phi4_momentum_sirk --no-run --message-format=json 2>&1)"; then
    printf '%s\n' "$build_json" >&2
    echo "the cross build failed" >&2
    exit 1
fi
binary="$(printf '%s\n' "$build_json" |
    grep '"kind":\["test"\]' |
    grep -o '"executable":"[^"]*"' | tail -1 |
    sed 's/.*:"//; s/"$//')"
if [ -z "$binary" ] || [ ! -x "$binary" ]; then
    echo "cargo did not report a test binary" >&2
    printf '%s\n' "$build_json" | tail -5 >&2
    exit 1
fi

# qemu needs the target's loader and libc under -L; libgcc_s is a private dependency
# of the cross gcc, so take it from the compiler itself rather than guessing.
libgcc_dir="$(dirname "$("$PHI4_CROSS_CC" -print-file-name=libgcc_s.so.1)")"

echo "== running $(basename "$binary") under $PHI4_CROSS_QEMU" >&2
LD_LIBRARY_PATH="$libgcc_dir" "$PHI4_CROSS_QEMU" -L "$PHI4_CROSS_SYSROOT" \
    "$binary" --nocapture --test-threads=1
