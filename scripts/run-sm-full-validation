#!/usr/bin/env bash
# Apply the host prerequisites from docs/SM_FULL_IMPLEMENTATION.md and run every
# reproducible command end to end: Cadabra2 export + CHECK rows, the two Rust
# test suites, and the JSON driver. Set CADABRA_CLI to override engine lookup.
set -euo pipefail
repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"

pin="$(sed -n 's/^channel = "\(.*\)"$/\1/p' rust-toolchain.toml)"
step() { printf '\n=== %s ===\n' "$*"; }

# Prepend the directory holding the first store path matching the pattern.
prepend_store_bin() {
    local pattern=$1 candidate
    shopt -s nullglob
    for candidate in $pattern; do
        [[ -x "$candidate" ]] || continue
        PATH="$(dirname "$candidate"):$PATH"
        shopt -u nullglob
        return 0
    done
    shopt -u nullglob
    return 1
}

step "host prerequisites: toolchain"
if ! command -v cargo >/dev/null 2>&1; then
    prepend_store_bin "/nix/store/*-cargo-${pin:-*}/bin/cargo" \
        || prepend_store_bin "/nix/store/*-cargo-*/bin/cargo" \
        || { echo "cargo not found: install Rust ${pin:-} or put it on PATH" >&2; exit 69; }
fi
command -v rustc >/dev/null 2>&1 \
    || prepend_store_bin "/nix/store/*-rustc-wrapper-*/bin/rustc" \
    || { echo "rustc not found: install Rust ${pin:-} or put it on PATH" >&2; exit 69; }
command -v cc >/dev/null 2>&1 || command -v gcc >/dev/null 2>&1 \
    || prepend_store_bin "/nix/store/*-gcc-wrapper-*/bin/cc" \
    || { echo "no C linker found: put cc, gcc or clang on PATH" >&2; exit 69; }
export PATH
echo "cargo $(cargo --version | awk '{print $2}'), $(rustc --version)"

step "host prerequisites: Cadabra2 engine"
# The working CLI + PYTHONHOME pair is recorded, because finding it means
# probing every Nix Python. A record is reused unless it is missing, stale, or
# fails the module probe below.
record="${SM_FULL_CADABRA_ENV:-$repo_root/target/tmp/cadabra-env}"
if [[ -z ${CADABRA_CLI:-} && -r $record ]]; then
    # shellcheck disable=SC1090
    . "$record"
    echo "reused engine record: $record"
fi
if [[ -n "${CADABRA_CLI:-}" ]]; then
    cli=$CADABRA_CLI
elif command -v cadabra2-cli >/dev/null 2>&1; then
    cli=$(command -v cadabra2-cli)
elif prepend_store_bin "/nix/store/*-cadabra2-*/bin/cadabra2-cli"; then
    cli=$(command -v cadabra2-cli)
else
    echo "Cadabra2 required: set CADABRA_CLI or run through nix-shell -p cadabra2" >&2
    exit 69
fi
export MPLCONFIGDIR="${MPLCONFIGDIR:-${TMPDIR:-/tmp}/sm-full-mpl}"
mkdir -p "$MPLCONFIGDIR"
# `--version` succeeds even when the engine cannot run a module, so probe with a
# trivial one. The wrapper resolves the host's system Python when that shadows
# the bundled stdlib and then aborts on '_struct'; retry against a Nix Python.
probe="$(mktemp)"
json=""
trap 'rm -f "$probe" ${json:+"$json"}' EXIT
printf 'print("cadabra-ok");\n' > "$probe"
# Capture before matching: grep -q would close the pipe early and pipefail
# would then report the engine's SIGPIPE, not the verdict.
engine_ok() {
    local out
    out="$("$cli" -q -n "$probe" 2>/dev/null || true)"
    [[ $out == *cadabra-ok* ]]
}
if ! engine_ok; then
    out=""
    shopt -s nullglob
    for py in /nix/store/*-python3-*/; do
        [[ -x "${py}bin/python3" ]] || continue
        out="$(PYTHONHOME="${py%/}" "$cli" -q -n "$probe" 2>/dev/null || true)"
        if [[ $out == *cadabra-ok* ]]; then
            export PYTHONHOME="${py%/}"
            break
        fi
    done
    shopt -u nullglob
fi
if ! engine_ok; then
    echo "Cadabra2 engine failed to start: check CADABRA_CLI and PYTHONHOME" >&2
    exit 69
fi
export CADABRA_CLI="$cli"
mkdir -p "$(dirname "$record")"
{
    printf 'CADABRA_CLI=%q\n' "$cli"
    [[ -z ${PYTHONHOME:-} ]] || printf 'PYTHONHOME=%q\n' "$PYTHONHOME"
} > "$record"
engine_version="$("$cli" --version 2>&1 | sed -n 1p || true)"
echo "engine: ${engine_version}${PYTHONHOME:+ (PYTHONHOME=$PYTHONHOME)}"
echo "recorded: $record"

step "cargo fetch --locked"
cargo fetch --locked

step "scripts/check-sm-symbolic"
./scripts/check-sm-symbolic

step "nested_fock_algebra: exact_inner_contract + sm_full_contract"
cargo test --locked --offline --release -p nested_fock_algebra --features latex \
    --test exact_inner_contract --test sm_full_contract -- --test-threads=1

step "fock_sirk: sm_full_hashimoto + sm_gauge_fixed_validation + N7/N8"
cargo test --locked --offline --release -p fock_sirk \
    --test sm_full_hashimoto --test sm_gauge_fixed_validation \
    --test sm_named_dictionary --test sm_car_bridge --test sm_defect \
    --test sm_defect_bridge --test sm_constraints --test sm_joint_constraints \
    --test sm_constraints_bridge --test sm_brst_jet_window \
    --test sm_momentum_validation \
    -- --test-threads=1

step "N13 CAR proof: pinned lean4export payload replayed by nanoda"
cargo run --locked --offline --release -q -p prob_kernel --example verify_export -- \
    docs/fixtures/sm_car_proof.ndjson

step "N8 finite endpoint proof: pinned lean4export payload replayed by nanoda"
cargo run --locked --offline --release -q -p prob_kernel --example verify_export -- \
    docs/fixtures/sm_defect_proof.ndjson

analytic="$(mktemp --suffix=.ndjson)"
window_proof="$(mktemp --suffix=.ndjson)"
jet_proof="$(mktemp --suffix=.ndjson)"
skew_proof="$(mktemp --suffix=.ndjson)"
trap 'rm -f "$probe" ${json:+"$json"} "$analytic" ${window_proof:+"$window_proof"} ${jet_proof:+"$jet_proof"} ${skew_proof:+"$skew_proof"}' EXIT

step "N8 matrix skew proof: gzip payload replayed by nanoda"
gzip -dc docs/fixtures/sm_defect_skew_proof.ndjson.gz > "$skew_proof"
skew_sha="$(sha256sum "$skew_proof" | awk '{print $1}')"
expected_skew_sha="498ae454792caafc7fb4150fb1cfb7a9ecf336d6a3b84d2ee9dcf9f80db528cc"
if [[ $skew_sha != "$expected_skew_sha" ]]; then
    echo "matrix-skew payload digest mismatch: $skew_sha (expected $expected_skew_sha)" >&2
    exit 65
fi
cargo run --locked --offline --release -q -p prob_kernel --example verify_export -- \
    "$skew_proof"
rm -f "$skew_proof"

step "N8 analytic defect proof: gzip payload replayed by nanoda"
gzip -dc docs/fixtures/sm_defect_analytic_proof.ndjson.gz > "$analytic"
analytic_sha="$(sha256sum "$analytic" | awk '{print $1}')"
expected_sha="83e3571ed458dff72b086934d57724be3b4763f47d58a07439b401c0d714ed31"
if [[ $analytic_sha != "$expected_sha" ]]; then
    echo "analytic payload digest mismatch: $analytic_sha (expected $expected_sha)" >&2
    exit 65
fi
cargo run --locked --offline --release -q -p prob_kernel --example verify_export -- \
    "$analytic"
rm -f "$analytic"

step "N10 finite BRST window proof: gzip payload replayed by nanoda"
gzip -dc docs/fixtures/sm_brst_finite_window_proof.ndjson.gz > "$window_proof"
window_sha="$(sha256sum "$window_proof" | awk '{print $1}')"
expected_window_sha="bedf7935645a691ed994869474b8e38409f7541ad314fa1c6c86255ca881664a"
if [[ $window_sha != "$expected_window_sha" ]]; then
    echo "finite-window payload digest mismatch: $window_sha (expected $expected_window_sha)" >&2
    exit 65
fi
cargo run --locked --offline --release -q -p prob_kernel --example verify_export -- \
    "$window_proof"
rm -f "$window_proof"

step "N10 jet-window proof: gzip payload replayed by nanoda"
gzip -dc docs/fixtures/sm_brst_jet_window_proof.ndjson.gz > "$jet_proof"
jet_sha="$(sha256sum "$jet_proof" | awk '{print $1}')"
expected_jet_sha="66ea3e84d009e03c9d34f86d7783def11f46f0c9600d6cc094320f1abf462e20"
if [[ $jet_sha != "$expected_jet_sha" ]]; then
    echo "jet-window payload digest mismatch: $jet_sha (expected $expected_jet_sha)" >&2
    exit 65
fi
cargo run --locked --offline --release -q -p prob_kernel --example verify_export -- \
    "$jet_proof"
rm -f "$jet_proof"

step "fock_sirk: N12 finite-mode pilot"
n12="$(mktemp)"
cargo run --locked --offline --release -p fock_sirk --example sm_finite_mode > "$n12"
python3 - "$n12" <<'PY'
import json
import sys

record = json.load(open(sys.argv[1]))
fixed = record["stability"]
running = record["running_stability"]
scheme = record["scheme_dependence"]
branch = record["branch_ambiguity"]
claims = record["claims"]
assert len(record["cells"]) == 5, "fixed family must cover M=4..8"
assert len(record["running_cells"]) == 5, "running family must cover M=4..8"
assert fixed["worst_embedding_deviation"] < 1e-12, fixed
assert fixed["coherent_number_spread"] < 1e-12, fixed
assert fixed["coherent_field_mean_spread"] < 1e-12, fixed
assert fixed["squeezed_field_variance_spread"] < 1e-12, fixed
assert running["worst_g4_residual"] < 1e-8, running
assert 0.0 < running["lambda_spread"] < 1e-2, running
assert running["worst_hamiltonian_embedding_deviation"] > 1e-6, running
assert scheme["worst_g4_residual"] < 1e-8, scheme
assert 0.0 < scheme["max_lambda_difference"] < 1e-2, scheme
assert branch["root_counts"] and min(branch["root_counts"]) >= 2, branch
assert branch["min_separation"] > 1e-3, branch
assert branch["low_branch_spread"] < 1e-3 and branch["high_branch_spread"] < 1e-3, branch
assert branch["max_coherent_energy_difference"] > 1e-3, branch
occupation = record["occupation_sensitivity"]
assert occupation["cutoff_4_matches_main"] is True, occupation
fixed = record["fixed_coupling_sensitivity"]
assert fixed["cutoff_dependent"] is True, fixed
assert fixed["max_cutoff_spread"] > 5e-2, fixed
assert fixed["cutoff_4_mode_drift"] > 1e-3, fixed
assert occupation["cutoff_6_two_roots"] is True, occupation
assert occupation["cutoff_6_high_branch_shift"] is True, occupation
assert claims["fixed_embedding_exact"] is True
assert claims["running_coupling_trajectory"] is True
assert claims["renormalization_condition_satisfied"] is True
assert claims["smearing_normalization_dependent"] is True
assert claims["matching_branch_not_unique"] is True
assert claims["branch_structure_cutoff_specific"] is True
assert claims["continuum_limit"] is False
assert claims["cutoff_uniform_theorem"] is False
lambdas = [cell["lambda"] for cell in record["running_cells"]]
print(
    "[ok] N12 fixed embedding exact, running lambda "
    f"{lambdas[0]:.9f}..{lambdas[-1]:.9f}, "
    f"G4 residual {running['worst_g4_residual']:.2e}, "
    f"smearing shift {scheme['max_lambda_difference']:.2e}, "
    f"matching branches {branch['root_counts']} sep {branch['min_separation']:.2e}, "
    f"branch energy gap {branch['max_coherent_energy_difference']:.2e}, "
    f"cutoff-6 high branch shifted: {occupation['cutoff_6_high_branch_shift']}, "
    f"fixed-lambda G4 spread {fixed['max_cutoff_spread']:.2e}"
)
PY
rm -f "$n12"

step "sm_full_hashimoto example (occupation cutoff 1)"
json="$(mktemp)"
cargo run --locked --offline --release -p fock_sirk --example sm_full_hashimoto -- \
    --time 0.01 --steps 1 --krylov 4 --occupation-cutoff 1 > "$json"
sed -n '/"full_action_tail_norms"/,/^  \]/p' "$json"
echo "[ok] JSON driver completed; expand with --occupation-cutoff 2 for the 230-state window"

# Wider windows need the raised budgets recorded in the doc and peak around 7 GB,
# so they are opt-in rather than part of the default sweep.
if [[ ${SM_FULL_WIDE_CUTOFFS:-0} == 1 ]]; then
    step "sm_full_hashimoto example: occupation cutoffs 2-4 (wide windows)"
    for c in 2 3 4; do
        wide="$(mktemp)"
        cargo run --locked --offline --release -p fock_sirk --example sm_full_hashimoto -- \
            --time 0.01 --steps 1 --krylov 4 --occupation-cutoff "$c" \
            --cache-limit 4000000 --action-components 8000000 --action-work 4000000000 \
            > "$wide"
        printf 'cutoff %s: ' "$c"
        python3 - "$wide" <<'PY'
import json, sys
record = json.load(open(sys.argv[1]))
projection = record["numerical_projection"]
print(
    f"dimension {projection['dimension']}, "
    f"leading full-action tail {record['full_action_tail_norms'][0][0]!r}"
)
PY
        rm -f "$wide"
    done
fi
