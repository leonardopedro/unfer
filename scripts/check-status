#!/usr/bin/env bash
# X2 — status-doc gate.
#
# Each repo's README carries a machine-readable status line:
#
#     <!-- status: verified | tests: 110 dune / 14 suites | last_verified: 2026-10-04 -->
#
# This checks two things:
#
#   1. every repo in the workspace HAS such a line (a missing block is drift --
#      an unstated status reads as an unverified one);
#   2. the `last_verified:` date is not in the future, which catches a typo'd or
#      copy-pasted date before it becomes a claim nobody checked.
#
# It deliberately does NOT re-run the suites. Counting tests differs per project
# (cargo test, dune runtest, pytest) and a gate that shells into all of them is a
# slow gate that gets skipped. The command behind each number is documented in
# that repo's README Verification section; this checks that the claim exists and
# is internally sane.
#
# X2 drift half (2026-10-06): `--recount REPO=LOG` recomputes a count from a log
# of that repo's own suite instead of trusting the block, so a count claim is
# checked by the run the repo already performs rather than by a second suite.
# The CI test job tees its output and passes the log here; locally the same
# command works against any captured run. A log containing a FAILED suite is
# not evidence of a count and is refused, not summed past.
#
# X2 drive half (2026-10-09): --recount only helped someone who already had a
# log, and no CI job and no human passes one -- so the numbers were checked by
# nothing, which was the remaining hole. `--run [REPO...]` runs the repo's own
# suite itself and feeds its log to the same recount path, so the check no
# longer depends on remembering to supply evidence.
#
# P4 half (2026-10-15): the recount fixes the *block*, but the same day's
# drift review found four README/AGENTS files whose test-count *prose*
# disagreed with their own just-recounted blocks -- the block was checked and
# the sentence above it was not. Count prose is drift like any other, so the
# two headline shapes a stale count actually ships as are now held to the
# block's number:
#
#   `# N passed`     the Verification snippet annotation
#   `N tests pass`   the README headline
#
# Sub-scope prose ("23 passing unit tests", "was 1785 on ...") deliberately
# does not match: a scoped number is not the block's to contradict. A
# sub-scope annotation that wants guard-grade treatment gets a scope label
# ("# fock_sirk: 401 passed ..."), which reads better anyway. The op-count
# form of this doctrine lives in velysterm's check-op-catalog (round-2 F4).
#
# Scope is deliberately narrow: only cargo-shaped suites can be recounted (the
# parser sums `test result: ok. N passed`), and only the repos registered in
# recount_cmd() below. Everything else -- dune, Lean, the link graph -- reports
# a gap rather than a failure, and `timepiece`'s marker honestly says "not run".
# A missing toolchain is a gap for the same reason as verify-invariants' gates:
# "no interpreter here" must not be indistinguishable from real drift.
#
# Usage:  scripts/check-status [--recount REPO=LOG ...] [--run [REPO ...]]
# Exit:   0 clean, 1 on a missing/invalid status block or a recounted mismatch.

set -uo pipefail

# shellcheck source=workspace-root.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/workspace-root.sh"

# Repos that must carry a status block, and the README to look in.
REPOS="australVM dynamic-arctic emthin unfer velysterm timepiece test"

today="$(date +%F)"
fail=0
checked=0
skipped=0
root="$(ws_root)"

# X2: presence is not visibility. `grep` finds `<!-- status: ... -->` inside a
# fenced code block too, where it renders as literal source text instead of a
# status line -- two READMEs shipped exactly that (the X2 insertion landed
# between an opener and its closer), and this gate passed over both because
# grep cannot see rendering. The same defect one level up is a fence left
# unclosed: it swallows everything after it as code. Track fence state with
# CommonMark's rule -- a *closing* fence carries no info string -- and report
# which problem a README has. Output: ok | trapped | unclosed | unseen.
status_fences() {
  awk '
    /^```/ {
      rest = $0; sub(/^`+/, "", rest)
      if (!open) { open = 1; next }
      if (rest ~ /^[[:space:]]*$/) open = 0
      next
    }
    /<!-- status:/ { seen = 1; if (open) trapped = 1 }
    END {
      if (trapped) { print "trapped"; exit 1 }
      if (open)    { print "unclosed"; exit 1 }
      if (!seen)   { print "unseen"; exit 1 }
      print "ok"
    }
  ' "$1"
}

# X2: optional recount requests, filled from --recount REPO=LOG and --run.
recount_specs=""
run_specs=""
run_all=0
while [ $# -gt 0 ]; do
  case "$1" in
    --recount)
      if [ $# -lt 2 ]; then
        echo "check-status: --recount needs REPO=LOG" >&2
        exit 2
      fi
      recount_specs="$recount_specs $2"
      shift 2
      ;;
    --run)
      shift
      if [ $# -eq 0 ]; then
        run_all=1
        break
      fi
      while [ $# -gt 0 ]; do
        case "$1" in
          --*) break ;;
          *) run_specs="$run_specs $1"; shift ;;
        esac
      done
      ;;
    *)
      echo "check-status: unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

# The cheapest command that produces a cargo-shaped log for a repo, i.e. the
# one already documented in that README's Verification section. Empty means
# "cannot be recounted" -- reported as a gap, never as a pass.
recount_cmd() {
  case "$1" in
    dynamic-arctic)
      printf '%s' 'cargo test --all-features --locked'
      ;;
    emthin)
      printf '%s' 'nix develop -c cargo test --workspace'
      ;;
    unfer)
      printf '%s' 'cargo test --workspace --exclude fock_sirk --locked'
      ;;
    velysterm)
      printf '%s' 'nix develop -c cargo test --workspace'
      ;;
    *)
      printf ''
      ;;
  esac
}

# Run a registered command inside the checkout, tee its output to a log, and
# return 0 only if a log was produced (whether or not the suite is green --
# recount_from_log is what judges a green suite a prerequisite for a count).
# The caller decides what "no command registered" means for its own output.
run_recount_cmd() {
  local repo="$1" dir="$2" log="$3" cmd
  cmd="$(recount_cmd "$repo")"
  if ! ( cd "$dir" && eval "$cmd" ) >"$log" 2>&1; then
    : # a failing suite still produces a log; recount_from_log refuses it below
  fi
  if [ ! -s "$log" ]; then
    printf 'gap  %-16s %s produced no output (tooling absent?)\n' "$repo" "$cmd"
    return 1
  fi
  return 0
}

# Sum `test result: ok. N passed` over a cargo-test log. Fails (rather than
# returning a number) when the log contains a FAILED suite: a broken run is not
# a count of a green suite, and printing "N passed" from it would be exactly
# the drift this gate exists to catch.
recount_from_log() {
  local log="$1"
  if [ ! -f "$log" ]; then
    printf 'FAIL recount: no such log: %s\n' "$log" >&2
    return 1
  fi
  if grep -qE '^test result: FAILED' "$log" || \
     grep -E '^test result:' "$log" | \
       awk '{f = $6; gsub(/[^0-9]/, "", f); if (f + 0 > 0) bad = 1} END {exit bad ? 0 : 1}'; then
    printf 'FAIL recount: %s contains a failed suite; a broken run cannot evidence a count\n' "$log" >&2
    return 1
  fi
  local n
  n="$(grep -E '^test result: ok\.' "$log" | awk '{s += $4} END {print s + 0}')"
  local suites
  suites="$(grep -cE '^test result:' "$log" || true)"
  if [ "$suites" -eq 0 ]; then
    printf 'FAIL recount: %s has no test-result lines (not a suite log?)\n' "$log" >&2
    return 1
  fi
  printf '%s' "$n"
}

printf 'check-status: status blocks (today %s, root %s)\n' "$today" "$root"

for repo in $REPOS; do
  if ! dir="$(ws_checkout "$repo")"; then
    printf 'skip %-16s (not checked out here)\n' "$repo"
    skipped=$((skipped + 1))
    continue
  fi

  block=""
  block_file=""
  for f in README.md README; do
    [ -f "$dir/$f" ] || continue
    block="$(grep -m1 -oE '<!-- status: [^>]*-->' "$dir/$f" || true)"
    if [ -n "$block" ]; then
      block_file="$dir/$f"
      break
    fi
  done

  if [ -z "$block" ]; then
    printf 'FAIL %-16s no status block in README\n' "$repo"
    fail=1
    continue
  fi
  checked=$((checked + 1))

  case "$(status_fences "$block_file")" in
    ok) ;;
    trapped)
      printf 'FAIL %-16s status block sits inside a code fence (renders as literal text)\n' "$repo"
      printf '       move the block above the fence, or close the fence before it: %s\n' "$block_file"
      fail=1
      continue
      ;;
    unclosed)
      printf 'FAIL %-16s unclosed code fence -- everything after it renders as code\n' "$repo"
      printf '       balance the fences in %s\n' "$block_file"
      fail=1
      continue
      ;;
    *)
      printf 'FAIL %-16s could not determine fence state of %s\n' "$repo" "$block_file"
      fail=1
      continue
      ;;
  esac

  for field in status tests last_verified; do
    if ! printf '%s' "$block" | grep -qE "$field: [^ ]"; then
      printf 'FAIL %-16s status block missing "%s:"\n' "$repo" "$field"
      printf '       %s\n' "$block"
      fail=1
    fi
  done

  date_field="$(printf '%s' "$block" | grep -oE 'last_verified: [0-9]{4}-[0-9]{2}-[0-9]{2}' | cut -d' ' -f2)"
  if [ -n "$date_field" ] && [ "$date_field" \> "$today" ]; then
    printf 'FAIL %-16s last_verified %s is in the future\n' "$repo" "$date_field"
    fail=1
    continue
  fi

  # Age is reported, not enforced: a stale-but-honest date is information, and
  # turning it into a hard failure only teaches people to bump the date without
  # running anything.
  if [ -n "$date_field" ]; then
    age_days=$(( ( $(date -d "$today" +%s) - $(date -d "$date_field" +%s) ) / 86400 ))
    if [ "$age_days" -gt 180 ]; then
      printf 'WARN %-15s last verified %s (%d days ago)\n' "$repo" "$date_field" "$age_days"
    fi
  fi

  # P4: prose claims vs the block. Only when the block carries a number --n  # an honest "none"/"not run" block cannot be contradicted by a count.
  block_count="$(printf '%s' "$block" | grep -oE 'tests: [0-9]+' | grep -oE '[0-9]+' | head -1)"
  if [ -n "$block_count" ]; then
    for f in README.md README AGENTS.md AGENTS; do
      [ -f "$dir/$f" ] || continue
      while IFS=: read -r lineno rest; do
        for num in $(printf '%s\n' "$rest" \
            | grep -oE '#[[:space:]]*[0-9][0-9,]* passed|[0-9][0-9,]* tests pass' \
            | grep -oE '[0-9][0-9,]*' | tr -d ',' | sort -u); do
          if [ "$num" != "$block_count" ]; then
            printf 'FAIL %-16s %s:%s: prose claims %s tests, block says %s\n' \
              "$repo" "$f" "$lineno" "$num" "$block_count"
            printf '       recount, then update the line -- or label its scope: "# <suite>: %s passed ..."\n' "$num"
            fail=1
          fi
        done
      done < <(grep -nE '#[[:space:]]*[0-9][0-9,]* passed|[0-9][0-9,]* tests pass' "$dir/$f" || true)
    done
  fi

  printf 'ok   %-16s %s\n' "$repo" "$block"

  # X2 drift half: if this repo's count was asked for, recompute it from its
  # suite log and hold the block to the number.
  for spec in $recount_specs; do
    case "$spec" in
      "$repo="*)
        log="${spec#*=}"
        claimed="$(printf '%s' "$block" | grep -oE 'tests: [0-9]+' | grep -oE '[0-9]+')"
        if [ -z "$claimed" ]; then
          printf 'FAIL %-16s recount requested but the block has no numeric count\n' "$repo"
          fail=1
          continue
        fi
        if measured="$(recount_from_log "$log")"; then
          if [ "$measured" = "$claimed" ]; then
            printf 'ok   %-16s recount: %s tests, matches the block (%s)\n' "$repo" "$measured" "$log"
          else
            printf 'FAIL %-16s recount: log shows %s tests, block claims %s (%s)\n' \
              "$repo" "$measured" "$claimed" "$log"
            printf '       update the status block after the suite run, or cite the same scope\n'
            fail=1
          fi
        else
          fail=1
        fi
        ;;
    esac
  done

  # X2 drive half: --run executes this repo's own registered suite and feeds
  # its log to the very same recount path above, so the number in the block is
  # checked without somebody having to remember to pass a log. The comparison
  # is identical to --recount's; only the way the evidence arrives differs.
  if [ "$run_all" -eq 1 ] || [ -n "$run_specs" ]; then
    want=0
    if [ "$run_all" -eq 1 ]; then
      want=1
    else
      for r in $run_specs; do [ "$r" = "$repo" ] && want=1; done
    fi
    if [ "$want" -eq 1 ]; then
      if [ -z "$(recount_cmd "$repo")" ]; then
        printf 'gap  %-16s not recounted: suite is not cargo-shaped (no parser for it)\n' "$repo"
      else
        log="$(mktemp -t "check-status.$repo.XXXXXX")"
        printf 'run  %-16s %s\n' "$repo" "$(recount_cmd "$repo")"
        if run_recount_cmd "$repo" "$dir" "$log"; then
          claimed="$(printf '%s' "$block" | grep -oE 'tests: [0-9]+' | grep -oE '[0-9]+' | head -1)"
          if [ -z "$claimed" ]; then
            printf 'gap  %-16s block has no numeric count to compare against\n' "$repo"
          elif measured="$(recount_from_log "$log")"; then
            if [ "$measured" = "$claimed" ]; then
              printf 'ok   %-16s recount: %s tests, matches the block\n' "$repo" "$measured"
            else
              printf 'FAIL %-16s recount: suite reports %s tests, block claims %s\n' \
                "$repo" "$measured" "$claimed"
              printf '       update the status block after the suite run, or cite the same scope\n'
              fail=1
            fi
          else
            fail=1
          fi
        fi
        rm -f "$log"
      fi
    fi
  fi
done

if [ "$fail" -ne 0 ]; then
  echo >&2
  echo "check-status: a status block is missing or malformed. Add one to the" >&2
  echo "repo's README after actually running its suite:" >&2
  echo >&2
  echo '    <!-- status: verified | tests: <n> <cmd> | last_verified: YYYY-MM-DD -->' >&2
  exit 1
fi

# Zero repos inspected is not a pass. The root search this replaced needed three
# sibling checkouts and CI has two, so this gate used to print "0 repo(s)" and
# exit 0 -- green, having read nothing.
if [ "$checked" -eq 0 ]; then
  echo >&2
  echo "check-status: found no repo to check under $root." >&2
  echo "check-status: refusing to report a pass over zero repos." >&2
  exit 1
fi

printf 'check-status: %d repo(s) carry a status block' "$checked"
[ "$skipped" -gt 0 ] && printf ' (%d not checked out here)' "$skipped"
printf '\n'