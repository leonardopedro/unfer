#!/usr/bin/env bash
# X1 — drift gate for the shared LaTeX corpus.
#
# `timepiece/` is the source of record; `unfer/` holds a synced copy because its
# tests read `unfer/book.tex` and `unfer/ODE.tex` by that path. Those two files
# were byte-identical and nobody knew it, so the pair drifted apart silently
# before this gate existed -- and 724 KB of duplicated LaTeX is exactly the kind
# of thing that rots.
#
# Compares content, not timestamps: a stale mtime with matching bytes is fine.
#
# Usage:  scripts/check-book-sync
# Exit:   0 in sync, 1 on drift or a missing file.

set -uo pipefail

# shellcheck source=workspace-root.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/workspace-root.sh"

# Both sides of the pair are required: a gate that cannot see the source of
# record must fail loudly. Comparing against a path it invented is how this gate
# spent its first CI run comparing `/book.tex` with `/timepiece/book.tex`.
if ! corpus="$(ws_checkout timepiece)"; then
  echo "book-sync: cannot find the timepiece checkout (source of record)." >&2
  echo "          workspace root resolved to: $(ws_root)" >&2
  echo "          expected: <root>/timepiece -- check timepiece out as a" >&2
  echo "          sibling, or set WORKSPACE_ROOT." >&2
  exit 1
fi
if ! hub="$(ws_checkout unfer)"; then
  echo "book-sync: cannot find the unfer checkout (mirror)." >&2
  echo "          workspace root resolved to: $(ws_root)" >&2
  echo "          expected: <root>/unfer -- check unfer out as a sibling," >&2
  echo "          or set WORKSPACE_ROOT." >&2
  exit 1
fi

FILES=(book.tex ODE.tex)
drift=0

printf 'book-sync: source of record = %s, mirrored into %s\n' "$corpus" "$hub"
for f in "${FILES[@]}"; do
  src="$corpus/$f"
  dst="$hub/$f"

  if [ ! -f "$src" ]; then
    printf 'FAIL %-9s source of record missing: %s\n' "$f" "$src" >&2
    drift=1
    continue
  fi
  if [ ! -f "$dst" ]; then
    printf 'FAIL %-9s mirror missing: %s\n' "$f" "$dst" >&2
    printf '       run scripts/sync-book\n' >&2
    drift=1
    continue
  fi

  a="$(sha256sum "$src" | cut -d' ' -f1)"
  b="$(sha256sum "$dst" | cut -d' ' -f1)"
  if [ "$a" != "$b" ]; then
    printf 'FAIL %-9s drifted\n' "$f" >&2
    printf '       timepiece %s\n' "$a" >&2
    printf '       unfer     %s\n' "$b" >&2
    drift=1
  else
    printf 'ok   %-9s %s\n' "$f" "${a:0:16}"
  fi
done

if [ "$drift" -ne 0 ]; then
  echo >&2
  echo "book-sync: timepiece/ is the source of record. After editing it, run:" >&2
  echo "    scripts/sync-book" >&2
  echo "and commit the unfer/ copy in the same commit." >&2
  exit 1
fi

echo "book-sync: in sync"