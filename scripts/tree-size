#!/usr/bin/env bash
# X5 — build-artifact gate.
#
# Fails when a build directory, bytecode cache, or compiler-emitted report is
# tracked in git. Written because .gitignore alone is not enough: a file
# committed *before* the ignore rule was added stays tracked forever, which is
# how a 1.2 MB generated `calltree.html` and a CPython `.pyc` came to sit in
# two repos' histories.
#
# Usage:  scripts/tree-size [repo ...]      (defaults to every sibling checkout)
# Exit:   0 clean, 1 if anything is tracked that should not be, or if a kept
#         directory has drifted from its retention policy.
#
# ## Retention policy (X5, 2026-10-07) — what is kept, and why
#
# Tracked = cited evidence. Everything generated is untracked, and a file a
# document actually cites may be retained tracked by whitelisting it by name
# in that repo's .gitignore — the repo's own ignore rules are the authority
# for which is which (the check below probes them with `git check-ignore
# --no-index`, never the index). Two directories have a stated rule:
#
#   qfm_text_runs/  pinned experimental evidence. Only `metrics.ndjson`,
#                   `train.log` and `train.toml` are tracked — the numbers the
#                   test suites cite. Checkpoints (`*.qfm`, ~3.9 GB) are
#                   gitignored and removed by `tools/clean_qfm_text_runs.sh`
#                   (dry-run by default). Any other tracked file under
#                   `qfm_text_runs/` fails this gate: retention is an
#                   allowlist, not a default.
#   logs/           ephemeral run logs, gitignored wholesale. The exception
#                   is a log cited as evidence (e.g. `logs/heavy_tests_*.log`,
#                   the recorded ALL-GREEN run), whitelisted by name in
#                   .gitignore. `logs/*` is gitignored, `!logs/<cited>` is the
#                   retention act.
#
# Deleting stale artifacts is therefore always safe for anything NOT tracked
# here; amending retention is a deliberate edit to the allowlist above (and to
# .gitignore), never a side effect of a commit.
#
# ## Identity contract (record: scripts/check-backup-sync, 2026-10-14)
#
# This file has ONE canonical copy — the workspace-root `scripts/tree-size` —
# and two asserted byte-identical mirrors:
#
#   unfer/scripts/tree-size  per-repo mirror; unfer's CI runs it directly
#     (`bash scripts/tree-size` in ci.yml), so drift there would stay green at
#     the root and go red only in unfer's own pipeline — the same failure
#     shape check-attribution's mirror had.
#   emthin/workspace-backup/scripts/tree-size  backup mirror (manifest:
#     scripts/workspace-backup-files); the workspace root is not a git repo,
#     so the mirror gives this file version control.
#
# Both halves are asserted `cmp`-identical: the unfer pair by
# scripts/check-backup-sync, the backup pair by scripts/sync-workspace-backup
# --check. Edit HERE, then re-copy into unfer/scripts/ and run
# scripts/sync-workspace-backup; commit both mirrors in their own repos.

set -uo pipefail

# shellcheck source=workspace-root.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/workspace-root.sh"

# Directories and files that are outputs, never sources. Matched against
# repo-relative paths from `git ls-files`.
PATTERNS='(^|/)(_build|target|node_modules|__pycache__|\.venv|venv)/|(^|/)(calltree|error)\.html$|\.py[co]$|(^|/)logs?/[^/]*\.log$|\.orig$|\.rej$|\.swp$|~$|(^|/)\.DS_Store$'

# `qfm_text_runs/` is deliberately absent from the artifact patterns: its
# metrics.ndjson and train.log are pinned experimental evidence cited by the
# test suites, not build detritus — and a pattern would flag an intentional
# retention. Its *shape* (evidence-only) is enforced separately below.

if [ "$#" -gt 0 ]; then
  roots=("$@")
else
  mapfile -t roots < <(ws_all_checkouts)
fi

# Zero repos means the gate inspected nothing. Exiting 0 here is how this gate
# spent its first CI run reporting "clean" over zero checkouts: the old root
# search needed three siblings, CI had two, and a gate that finds no repos must
# not read as a repo that has no artifacts.
if [ "${#roots[@]}" -eq 0 ]; then
  echo "tree-size: no git checkouts found (looked under $(ws_root))" >&2
  echo "tree-size: refusing to report 'clean' over zero repos." >&2
  exit 1
fi

total=0
for repo in "${roots[@]}"; do
  [ -d "$repo/.git" ] || {
    echo "tree-size: skipping $repo (not a git checkout)" >&2
    continue
  }

  # X5 retention shape: qfm_text_runs/ is an allowlist (see the header).
  # Checked before the artifact scan (which `continue`s past repos with no
  # artifact hits) because this is retention drift, not a build artifact —
  # the remedy is an allowlist edit or an untrack, and the message should say
  # which policy was crossed.
  evidence_bad="$(git -C "$repo" ls-files -- 'qfm_text_runs' 2>/dev/null | \
    grep -vE '(^|/)(metrics\.ndjson|train\.log|train\.toml)$' || true)"
  if [ -n "$evidence_bad" ]; then
    total=$((total + 1))
    echo "FAIL $repo: tracked file(s) outside the qfm_text_runs/ retention policy" >&2
    printf '%s\n' "$evidence_bad" | sed 's/^/       /' >&2
    echo "       Policy: only metrics.ndjson / train.log / train.toml are retained" >&2
    echo "       as evidence (scripts/tree-size header). Untrack with:" >&2
    echo "       git -C $repo rm --cached <path>" >&2
  fi

  hits="$(git -C "$repo" ls-files | grep -E "$PATTERNS" || true)"
  if [ -z "$hits" ]; then
    echo "ok   $repo: no tracked build artifacts"
    continue
  fi

  # A repo may deliberately keep one of these. unfer's .gitignore whitelists
  # `logs/heavy_tests_*.log` as "the cited ALL-GREEN evidence log", so a blanket
  # pattern would flag an intentional retention and train people to delete it.
  # The repo's own ignore rules are the authority.
  #
  # `--no-index` is essential. Without it `git check-ignore` consults the index
  # and therefore reports *nothing* as ignored for a tracked file -- which made
  # this loop classify every tracked path as "deliberately kept" and the gate
  # unable to fail at all. It passed with a tracked .pyc still staged. Probe the
  # rules, not the index.
  real_hits=""
  kept=""
  while IFS= read -r h; do
    [ -n "$h" ] || continue
    if git -C "$repo" check-ignore --no-index -q "$h" 2>/dev/null; then
      real_hits="$real_hits$h"$'\n'
    else
      kept="$kept$h"$'\n'
    fi
  done <<< "$hits"

  n_real="$(printf '%s' "$real_hits" | grep -c . || true)"
  n_kept="$(printf '%s' "$kept" | grep -c . || true)"

  if [ "$n_real" -gt 0 ]; then
    total=$((total + n_real))
    echo "FAIL $repo: $n_real tracked build artifact(s)" >&2
    printf '%s' "$real_hits" | sed 's/^/       /' >&2
    echo "       Untrack with: git -C $repo rm --cached <path>" >&2
  fi
  if [ "$n_kept" -gt 0 ]; then
    echo "ok   $repo: $n_kept deliberately kept (whitelisted in .gitignore)" >&2
    printf '%s' "$kept" | sed 's/^/       kept: /' >&2
  fi
  if [ "$n_real" -eq 0 ] && [ "$n_kept" -eq 0 ]; then
    echo "ok   $repo: no tracked build artifacts"
  fi
done

if [ "$total" -gt 0 ]; then
  echo >&2
  echo "tree-size: $total violation(s) — a tracked build artifact, or a tracked" >&2
  echo "file outside a kept directory's retention policy. These are generated;" >&2
  echo "commit the .gitignore rule AND git rm --cached the file -- an ignore" >&2
  echo "added later does not apply retroactively." >&2
  exit 1
fi

echo "tree-size: clean"