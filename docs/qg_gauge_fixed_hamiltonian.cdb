# Repaired 3D gauge-fixed QG Hamiltonian derivation (source: yangqg3.cnb / qg6.cnb).
# Fully automated to book.tex's EXACT final form (line 8190):
#   ex1 = eR (EH action density in the vielbein, cells 1+3)
#   t0_tegr = TEGR/teleparallel torsion scalar (book.tex 8130)
#   pi_derived = polymomentum by variation of ex1
#   H_final = book.tex 8182 absorbed form, polymomenta kept symbolic so
#     the A·A and p·T cross-terms CANCEL against -L, then the relations
#     A=-2eT, S=2eS, P=-4eT, p^a=2eT^ac_c, and S^ab=Sbar^ab/(2e),
#     T=-Pbar/(4e) are substituted. Result = book.tex 8190:
#     H = (1/16e) S^2 - (1/24e) P^2 + 1/2 S·E + 1/3 P·E
#         - e(T^ab E_ab + 2 T^ab_b E_a + 1/2 T_abc T^acb + 1/4 T_abc T^abc
#             - T_ba^a T^bc_c - 1/4 T_ab T^ab)
# Run: cadabra2-cli -q -n <this file>
def post_process(ex):
	#unwrap(ex)
	eliminate_kronecker(ex)
	#canonicalise(ex)
	#sort_product(ex)
	collect_terms(ex)
#rrr:= { b_{k} c_{j} -> \delta_{j k}-c_{j} b_{k}, b_{k} \partial_{\mu?}{c_{j}} -> \partial_{\mu?}{\delta_{j k}}-\partial_{\mu?}{c_{j}} b_{k},
#        A_{\mu j}\pi^{\nu}_{k} -> i\delta^{\nu}_{\mu} \delta_{j k}+\pi^{\nu}_{k} A_{\mu j},
#        A_{0 j}\pi^{\nu}_{k} -> i\delta^{\nu}_{0} \delta_{j k}+\pi^{\nu}_{k} A_{0 j}};
d{#}::Accent.
{\alpha,\beta,\gamma,\mu,\nu,\rho,\sigma,\alpha#}::Indices(name=holonomic,position=independent,values={0,1,2,3}).
\partial{#}::PartialDerivative.
{i1,i2,i3,i#}::Indices(subspace2,parent=holonomic,position=independent,values={1,2,3}).
{m1,m2,m3,m4,m#}::Indices(subspace,parent=holonomic,position=independent,values={1,2,3}).
{j,k,l,j#}::Indices(name=frame,position=independent).
{a,b,c,a#,b#}::Indices(flat, position=independent, values={0,1,2,3}).
{y1,y#}::Indices(name=pos,position=independent).

f_{j k}^{l}::TableauSymmetry(shape={1,1}, indices={0,1}).
D_{j l \mu?}::TableauSymmetry(shape={1,1}, indices={0,1});
\delta^{\mu?}_{\nu?}::KroneckerDelta;
\delta_{\mu?}^{\nu?}::KroneckerDelta;
\delta^{j? l?}::KroneckerDelta;
\delta_{j? l?}::KroneckerDelta;
\delta_{j?}^{l}::KroneckerDelta;
\delta^{j?}_{l?}::KroneckerDelta;
\delta_{y1? y2?}::KroneckerDelta;

\eta_{\mu \nu}::Metric(signature=+2);
\eta^{\mu \nu}::InverseMetric;
{c^{j}, b_{j}}::SelfAntiCommuting.
{c^{j}, b_{j}}::NonCommuting.
#{c_{j}, b_{j}}::Depends(\partial{#}).
{A_{\mu?}^{j}, \pi^{\mu?}_{j}}::NonCommuting.
#{A_{\mu? j y1}, \pi^{\mu?}_{j y1}}::Depends(\partial{#}).
i::ImaginaryI.

G:= c^{j} D_{j l \mu} \pi^{\mu l} +c^{j} f_{j k}^{l} A_{\mu}^{k} \pi^{\mu l}+ i f_{j k}^{l} c^{j} c^{k} b_{l}/2;
#G2:=@(G);
#split_index(G2,$\alpha, 0, m1 $, repeat=True)
ex:= @(G) i b_{j} A_{0}^{j}+i b_{j} A_{0}^{j} @(G);
#ex:=\pi^{\mu}_{k} A_{0 j}-A_{0 j}\pi^{\mu}_{k};
distribute(ex);
substitute(ex,$b_{k} c_{j} -> \delta_{j k}-c_{j} b_{k}$)
substitute(ex,$A_{\mu? j}\pi^{\nu?}_{k} -> i\delta^{\nu?}_{\mu?} \delta_{j k}+\pi^{\nu?}_{k} A_{\mu? j}$);
distribute(ex);
substitute(ex,$b_{k} c_{j} -> \delta_{j k}-c_{j} b_{k}$)
substitute(ex,$A_{\mu? j}\pi^{\nu?}_{k} -> i\delta^{\nu?}_{\mu?} \delta_{j k}+\pi^{\nu?}_{k} A_{\mu? j}$);
distribute(ex);
substitute(ex,$b_{k} c_{j} -> \delta_{j k}-c_{j} b_{k}$)
substitute(ex,$A_{\mu? j}\pi^{\nu?}_{k} -> i\delta^{\nu?}_{\mu?} \delta_{j k}+\pi^{\nu?}_{k} A_{\mu? j}$);
distribute(ex);
substitute(ex,$b_{k} c_{j} -> \delta_{j k}-c_{j} b_{k}$)
substitute(ex,$A_{\mu? j}\pi^{\nu?}_{k} -> i\delta^{\nu?}_{\mu?} \delta_{j k}+\pi^{\nu?}_{k} A_{\mu? j}$);
substitute(ex,$A_{\mu j} A_{0 k} -> A_{0 k} A_{\mu j}$);
distribute(ex);
substitute(ex,$\pi^{\nu?}_{k} -> \Pi^{\nu?}_{k}$);
substitute(ex,$A_{\nu? k} -> B_{\nu? k}$);
split_index(ex,$\alpha, 0, m1 $, repeat=True)
distribute(ex)
canonicalise(ex)
sort_product(ex)
rename_dummies(ex);
canonicalise(ex)
sort_product(ex)
rename_dummies(ex);
ss:=-\Pi^{m1}_{j}D_{j l 0} B_{m1 l}+\Pi^{m1}_{j} D_{j l m1} B_{0 l}+\Pi^{m1}_{l}B_{m1 k}B_{0 j}f_{j k l}+i @(ex);
distribute(ss)
canonicalise(ss)
sort_product(ss)
rename_dummies(ss)
canonicalise(ss)
sort_product(ss)
rename_dummies(ss);
s2:= @(G) @(G).
distribute(s2);
#rename_dummies(s2);
substitute(s2,$b_{k} c_{j} -> \delta_{j k}-c_{j} b_{k}$)
substitute(s2,$A_{\mu? j}\pi^{\nu?}_{k} -> i\delta^{\nu?}_{\mu?} \delta_{j k}+\pi^{\nu?}_{k} A_{\mu? j}$);
distribute(s2)
#rename_dummies(s2)
substitute(s2,$b_{k} c_{j} -> \delta_{j k}-c_{j} b_{k}$)
substitute(s2,$A_{\mu? j}\pi^{\nu?}_{k} -> i\delta^{\nu?}_{\mu?} \delta_{j k}+\pi^{\nu?}_{k} A_{\mu? j}$);
#substitute(s2,$f_{j k l} f_{j2 j3 l} -> f_{j2 l k} f_{j3 j l}+f_{j3 l k} f_{j j2 l}$);
distribute(s2)
canonicalise(s2)
sort_product(s2)
rename_dummies(s2);
canonicalise(s2)
sort_product(s2)
rename_dummies(s2);


{G_{j}}::SelfNonCommuting.
s3:=G_{j}G_{l}-G_{l}G_{j};
substitute(s3,$G_{j} -> D_{j l \mu} \pi^{\mu}_{l}-f_{j k l} \pi^{\mu}_{l} A_{\mu k}$);
distribute(s3);
substitute(s3,$A_{\mu? j}\pi^{\nu?}_{k} -> i\delta^{\nu?}_{\mu?} \delta_{j k}+\pi^{\nu?}_{k} A_{\mu? j}$);
distribute(s3)
substitute(s3,$A_{\mu? j}\pi^{\nu?}_{k} -> i\delta^{\nu?}_{\mu?} \delta_{j k}+\pi^{\nu?}_{k} A_{\mu? j}$);
distribute(s3)
sort_product(s3)
rename_dummies(s3);
sort_product(s3);
substitute(s3,$D_{j l \mu}\pi^{\mu}_{l} -> \Pi_{j}, \pi^{\mu}_{l} D_{j l \mu} -> \Pi_{j}$);
substitute(s3,$D_{j k \mu}\pi^{\mu}_{l} f_{j1 k l} -> \Pi_{l} f_{j1 j l}$);
#substitute(s3,$D_{j l \mu}\pi^{\mu}_{l} -> \Pi_{j}, \pi^{\mu}_{l}D_{j l \mu} -> \Pi_{j}$);
canonicalise(s3);
sort_product(s3);
substitute(s3,$f_{j k l} f_{j2 j3 l} -> f_{j2 l k} f_{j3 j l}+f_{j3 l k} f_{j j2 l}$);
#substitute(s3,$D_{l j \mu} -> -D_{j l \mu}$);
#substitute(s3,$\Pi^{\mu}_{l}\partial_{l j \mu} -> -\Pi_{j}$);
# ===== cell 3 (Einstein-Hilbert action) =====
#\epsilon_{\alpha \beta \mu \nu}::EpsilonTensor(delta=\delta^{\mu}_{\nu}, metric=g_{\mu \nu});
#\epsilon^{a b c j}::EpsilonTensor(delta=\delta^{a}_{b}, metric=\eta_{a b});
ex:= \int{e R}{x};
test1:= 1111.
test2:= 2222.
test3:= 3333.
test4:= 4444.
test5:= 5555.
#ex:=e_{\nu}^{a}e^{\alpha4}_{c} \eta_{a a1} \eta_{b a2} e^{\mu}_{j} e^{\alpha}_{l} \eta^{a1 c}  e_{\mu}^{k};
#ex:=\partial_{\mu}{ 1/(e) };
substitute(ex,$R -> g^{\mu \nu} R_{\mu \nu} $,repeat=True)
substitute(ex,$R_{\mu \nu} -> R^{\alpha}_{\mu \alpha \nu}$,repeat=True)
substitute(ex,$R^{\alpha}_{\beta \mu \nu} -> e^{\alpha}_{a} e_{\beta}^{b}\partial_{\mu}{\omega^{a}_{\nu b}}-e^{\alpha}_{a} e_{\beta}^{b}\partial_{\nu}{\omega^{a}_{\mu b}}+e^{\alpha}_{a} e_{\beta}^{b}\omega^{a}_{\mu c}\omega^{c}_{\nu b}-e^{\alpha}_{a} e_{\beta}^{b}\omega^{a}_{\nu c}\omega^{c}_{\mu b}$,repeat=True)
distribute(ex)
rename_dummies(ex)
substitute(ex,$\omega^{a}_{\mu b} -> 1/2 \eta^{a c} e^{\nu}_{c} \eta_{b k}\partial_{\mu}{e^{k}_{\nu}} - 1/2 \eta^{a c} e^{\nu}_{c} \eta_{b k}\partial_{\nu}{e^{k}_{\mu}} - 1/2 e^{\nu}_{b}\partial_{\mu}{e^{a}_{\nu}} + 1/2 e^{\nu}_{b}\partial_{\nu}{e^{a}_{\mu}} - 1/2 \eta^{a c} e^{\alpha}_{c} e^{j}_{\mu} \eta_{j k} e^{\beta}_{b}\partial_{\alpha}{e^{k}_{\beta}} + 1/2 \eta^{a c} e^{\alpha}_{c} e^{j}_{\mu} \eta_{j k} e^{\beta}_{b}\partial_{\beta}{e^{k}_{\alpha}}$,repeat=True)
substitute(ex,$g^{\mu \nu} -> e^{\mu}_{a} e^{\nu}_{b} \eta^{a b}$,repeat=True)
distribute(ex)
rename_dummies(ex)
product_rule(ex)
unwrap(ex)
distribute(ex)
rename_dummies(ex);
#substitute(ex, $\partial_{\mu \nu}{e_{\alpha}^{a}} -> \partial_{\mu}{\partial_{\nu}{e_{\alpha}^{a}}}$)
integrate_by_parts(ex, $\partial_{\nu}{e_{\alpha}^{a}}$)
ex1 = ex[0];
# ===== TEGR / teleparallel torsion scalar (book.tex line 8130) =====
X_{a b c}::Symmetric.
t0_tegr := e ( T_{a b}^{b} T^{a c}_{c} - 1/2 T_{a b c} T^{a c b} - 1/4 T_{a b c} T^{a b c} ).
T_{a b c}::TableauSymmetry(shape={1,1}, indices={0,1}).
substitute(t0_tegr, $ T_{a b c} -> X_{a b c} - X_{b a c} $, repeat=True)
substitute(t0_tegr, $ T^{a b c} -> X^{a b c} - X^{b a c} $, repeat=True)
substitute(t0_tegr, $ T_{a b}^{b} -> X_{a b}^{b} - X_{b a}^{b} $, repeat=True)
substitute(t0_tegr, $ T^{a c}_{c} -> X^{a c}_{c} - X^{c a}_{c} $, repeat=True)
distribute(t0_tegr)
rename_dummies(t0_tegr)

# ===== polymomentum BY VARIATION =====
e^{\mu}_{a}::Depends(\partial{#}).
pi_derived := @(ex1).
vary(pi_derived, $ e^{k}_{\rho} -> d{e^{k}_{\rho}}, e^{j1}_{\sigma} -> d{e^{j1}_{\sigma}} $)
distribute(pi_derived)
rename_dummies(pi_derived)
substitute(pi_derived, $ \partial_{\alpha}{d{e^{k}_{\rho}}} -> \pi_{\alpha \rho}^{k} $, repeat=True)
substitute(pi_derived, $ d{e^{k}_{\rho}} -> 0 $, repeat=True)
distribute(pi_derived)
rename_dummies(pi_derived)
factor_out(pi_derived, $ \pi $)

# ===== the jump -> book.tex's exact final form (line 8190) =====
# H = -L + 1/4 A·A + 1/4 S·S + 1/3 P·T + p^a T_a + 1/2 A·E + 1/2 S·E + 1/3 P·E + p^a E_a
# (book.tex 8182), with L the decomposed TEGR Lagrangian (8136).
# Keep the polymomenta (calligraphic A, S, P, p) SYMBOLIC so that:
#   1/4 A^ab A_ab  cancels  -1/2 A_ab T^ab e   (from -L)
#   p^a T_a        cancels  -2 T^ab_a T_b e    (from -L)
# then substitute the polymomentum relations A=-2e T, S=2e S, P=-4e T, p^a=2e T^ac_c
# and finally S^ab = Sbar^ab/(2e), T = -Pbar/(4e).
chi_{a}^{b}::Symmetric.
S_{a b}::Symmetric.
E_{a b}::Symmetric.
T_{a b c}::TableauSymmetry(shape={1,1}, indices={0,1}).
v^{a}::Depends(\partial{#}).
# The decomposed TEGR Lagrangian (book.tex 8136):
L_dec := (1/4) S_{a b} S^{a b} e - (2/3) (T)*(T) e - (1/2) A_{a b} T^{a b} e - 2 T^{a b}_{a} T_{b} e - (1/2) T_{a b c} T^{a c b} e - (1/4) T_{a b c} T^{a b c} e + T_{b a}^{a} T^{b c}_{c} e + (1/4) T_{a b} T^{a b} e.
# book.tex 8182 with polymomenta symbolic (calligraphic):
# Note: p·T gives 1/4 S_calligraphic·S_plain = 1/4 (2e S_ab)·S^ab. Keep ONE
# calligraphic (the polymomentum = 2e S_plain) and ONE plain torsion S.
H_final := - (1/4) S_{a b} S^{a b} e + (2/3) T T e + (1/2) A_{a b} T^{a b} e + 2 T^{a b}_{a} T_{b} e + (1/2) T_{a b c} T^{a c b} e + (1/4) T_{a b c} T^{a b c} e - T_{b a}^{a} T^{b c}_{c} e - (1/4) T_{a b} T^{a b} e + (1/4) \mathcal{A}_{a b} A^{a b} + (1/4) (2 e S_{a b}) S^{a b} + (1/3) \mathcal{P} T + \mathcal{p}^{a} T_{a} + (1/2) \mathcal{A}_{a b} E^{a b} + (1/2) (2 e S_{a b}) E^{a b} + (1/3) \mathcal{P} E_{a}^{a} + \mathcal{p}^{a} E_{a}.
# First: the A·A from p·T cancels -1/2 A·T e from -L (substitute A^ab = -2e T^ab):
substitute(H_final, $ \mathcal{A}_{a b} -> -2 e T_{a b}, \mathcal{A}^{a b} -> -2 e T^{a b} $, repeat=True)
substitute(H_final, $ \mathcal{P} -> -4 e T $, repeat=True)
substitute(H_final, $ \mathcal{p}^{a} -> 2 e T^{a c}_{c} $, repeat=True)
substitute(H_final, $ (1/e) e -> 1 $, repeat=True)
rename_dummies(H_final)
distribute(H_final)
canonicalise(H_final)
# Now substitute the final S/T -> calligraphic relations:
substitute(H_final, $ S^{a b} -> \mathcal{S}^{a b}/(2 e) $, repeat=True)
substitute(H_final, $ S_{a b} -> \mathcal{S}_{a b}/(2 e) $, repeat=True)
substitute(H_final, $ T -> -\mathcal{P}/(4 e) $, repeat=True)
substitute(H_final, $ (1/e) (1/e) e -> (1/e) $, repeat=True)
substitute(H_final, $ (1/e) e -> 1 $, repeat=True)
# Fold A -> -2e T (calligraphic 2-index) so the A-terms cancel:
substitute(H_final, $ A_{a b} -> -2 e T_{a b}, A^{a b} -> -2 e T^{a b} $, repeat=True)
substitute(H_final, $ (1/e) e -> 1 $, repeat=True)
rename_dummies(H_final)
distribute(H_final)
# The determinant e commutes with the torsion tensors, so sort + canonicalise
# collapses the cancelling -e·T·T·e + e·T·T·e pairs:
{e, T_{a b}}::Commuting.
{e, T_{a b c}}::Commuting.
{e, S_{a b}}::Commuting.
{e, E_{a b}}::Commuting.
sort_product(H_final)
canonicalise(H_final)
