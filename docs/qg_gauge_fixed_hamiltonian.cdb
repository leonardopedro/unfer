# Repaired 3D gauge-fixed QG Hamiltonian derivation (source: yangqg3.cnb / qg6.cnb).
# Repairs vs the notebook:
#   (1) added \\partial{#}::PartialDerivative (needed by the Riemann substitution)
#   (2) added flat index set {a,b,c,a#,b#} (tetrad indices were undeclared)
#   (3) added \\sigma to the curved index set (used by the spin connection)
#   (4) added subspace index sets {i1,i2,i3} / {m1,m2,m3} for the 3+1 split
#   (5) fixed R^{\\alpha}_{\\mu \\alpha \\nu} extra-brace typo
#   (6) rewrote the spin-connection substitution as an index-balanced sum
#         (Cadabra rejects factored sums in replacement RHS)
#   (7) added the TEGR / teleparallel deliverable: ex1 = eR reduces to
#         book.tex's torsion scalar e(T_ab^b T^ac_c - 1/2 T_abc T^acb -
#         1/4 T_abc T^abc) with T_{abc} = X_{abc} - X_{bac}, up to the
#         total-divergence term (the standard TEGR identity).
# Cells: 1 (Gauss constraint + field content), 3 (Einstein-Hilbert action ->
# tetrad Hamiltonian), TEGR torsion scalar. Run: cadabra2-cli -q -n <this file>
def post_process(ex):
	#unwrap(ex)
	eliminate_kronecker(ex)
	#canonicalise(ex)
	#sort_product(ex)
	collect_terms(ex)
#rrr:= { b_{k} c_{j} -> \delta_{j k}-c_{j} b_{k}, b_{k} \partial_{\mu?}{c_{j}} -> \partial_{\mu?}{\delta_{j k}}-\partial_{\mu?}{c_{j}} b_{k},
#        A_{\mu j}\pi^{\nu}_{k} -> i\delta^{\nu}_{\mu} \delta_{j k}+\pi^{\nu}_{k} A_{\mu j},
#        A_{0 j}\pi^{\nu}_{k} -> i\delta^{\nu}_{0} \delta_{j k}+\pi^{\nu}_{k} A_{0 j}};
d{#}::Accent.
{\alpha,\beta,\gamma,\mu,\nu,\rho,\sigma,\alpha#}::Indices(name=holonomic,position=independent,values={0,1,2,3}).
\partial{#}::PartialDerivative.
{i1,i2,i3,i#}::Indices(subspace2,parent=holonomic,position=independent,values={1,2,3}).
{m1,m2,m3,m#}::Indices(subspace,parent=holonomic,position=independent,values={1,2,3}).
{j,k,l,j#}::Indices(name=frame,position=independent).
{a,b,c,a#,b#}::Indices(flat, position=independent, values={0,1,2,3}).
{y1,y#}::Indices(name=pos,position=independent).

f_{j k}^{l}::TableauSymmetry(shape={1,1}, indices={0,1}).
D_{j l \mu?}::TableauSymmetry(shape={1,1}, indices={0,1});
\delta^{\mu?}_{\nu?}::KroneckerDelta;
\delta_{\mu?}^{\nu?}::KroneckerDelta;
\delta^{j? l?}::KroneckerDelta;
\delta_{j? l?}::KroneckerDelta;
\delta_{j?}^{l}::KroneckerDelta;
\delta^{j?}_{l?}::KroneckerDelta;
\delta_{y1? y2?}::KroneckerDelta;

\eta_{\mu \nu}::Metric(signature=+2);
\eta^{\mu \nu}::InverseMetric;
{c^{j}, b_{j}}::SelfAntiCommuting.
{c^{j}, b_{j}}::NonCommuting.
#{c_{j}, b_{j}}::Depends(\partial{#}).
{A_{\mu?}^{j}, \pi^{\mu?}_{j}}::NonCommuting.
#{A_{\mu? j y1}, \pi^{\mu?}_{j y1}}::Depends(\partial{#}).
i::ImaginaryI.

G:= c^{j} D_{j l \mu} \pi^{\mu l} +c^{j} f_{j k}^{l} A_{\mu}^{k} \pi^{\mu l}+ i f_{j k}^{l} c^{j} c^{k} b_{l}/2;
#G2:=@(G);
#split_index(G2,$\alpha, 0, m1 $, repeat=True)
ex:= @(G) i b_{j} A_{0}^{j}+i b_{j} A_{0}^{j} @(G);
#ex:=\pi^{\mu}_{k} A_{0 j}-A_{0 j}\pi^{\mu}_{k};
distribute(ex);
substitute(ex,$b_{k} c_{j} -> \delta_{j k}-c_{j} b_{k}$)
substitute(ex,$A_{\mu? j}\pi^{\nu?}_{k} -> i\delta^{\nu?}_{\mu?} \delta_{j k}+\pi^{\nu?}_{k} A_{\mu? j}$);
distribute(ex);
substitute(ex,$b_{k} c_{j} -> \delta_{j k}-c_{j} b_{k}$)
substitute(ex,$A_{\mu? j}\pi^{\nu?}_{k} -> i\delta^{\nu?}_{\mu?} \delta_{j k}+\pi^{\nu?}_{k} A_{\mu? j}$);
distribute(ex);
substitute(ex,$b_{k} c_{j} -> \delta_{j k}-c_{j} b_{k}$)
substitute(ex,$A_{\mu? j}\pi^{\nu?}_{k} -> i\delta^{\nu?}_{\mu?} \delta_{j k}+\pi^{\nu?}_{k} A_{\mu? j}$);
distribute(ex);
substitute(ex,$b_{k} c_{j} -> \delta_{j k}-c_{j} b_{k}$)
substitute(ex,$A_{\mu? j}\pi^{\nu?}_{k} -> i\delta^{\nu?}_{\mu?} \delta_{j k}+\pi^{\nu?}_{k} A_{\mu? j}$);
substitute(ex,$A_{\mu j} A_{0 k} -> A_{0 k} A_{\mu j}$);
distribute(ex);
substitute(ex,$\pi^{\nu?}_{k} -> \Pi^{\nu?}_{k}$);
substitute(ex,$A_{\nu? k} -> B_{\nu? k}$);
split_index(ex,$\alpha, 0, m1 $, repeat=True)
distribute(ex)
canonicalise(ex)
sort_product(ex)
rename_dummies(ex);
canonicalise(ex)
sort_product(ex)
rename_dummies(ex);
ss:=-\Pi^{m1}_{j}D_{j l 0} B_{m1 l}+\Pi^{m1}_{j} D_{j l m1} B_{0 l}+\Pi^{m1}_{l}B_{m1 k}B_{0 j}f_{j k l}+i @(ex);
distribute(ss)
canonicalise(ss)
sort_product(ss)
rename_dummies(ss)
canonicalise(ss)
sort_product(ss)
rename_dummies(ss);
s2:= @(G) @(G).
distribute(s2);
#rename_dummies(s2);
substitute(s2,$b_{k} c_{j} -> \delta_{j k}-c_{j} b_{k}$)
substitute(s2,$A_{\mu? j}\pi^{\nu?}_{k} -> i\delta^{\nu?}_{\mu?} \delta_{j k}+\pi^{\nu?}_{k} A_{\mu? j}$);
distribute(s2)
#rename_dummies(s2)
substitute(s2,$b_{k} c_{j} -> \delta_{j k}-c_{j} b_{k}$)
substitute(s2,$A_{\mu? j}\pi^{\nu?}_{k} -> i\delta^{\nu?}_{\mu?} \delta_{j k}+\pi^{\nu?}_{k} A_{\mu? j}$);
#substitute(s2,$f_{j k l} f_{j2 j3 l} -> f_{j2 l k} f_{j3 j l}+f_{j3 l k} f_{j j2 l}$);
distribute(s2)
canonicalise(s2)
sort_product(s2)
rename_dummies(s2);
canonicalise(s2)
sort_product(s2)
rename_dummies(s2);


{G_{j}}::SelfNonCommuting.
s3:=G_{j}G_{l}-G_{l}G_{j};
substitute(s3,$G_{j} -> D_{j l \mu} \pi^{\mu}_{l}-f_{j k l} \pi^{\mu}_{l} A_{\mu k}$);
distribute(s3);
substitute(s3,$A_{\mu? j}\pi^{\nu?}_{k} -> i\delta^{\nu?}_{\mu?} \delta_{j k}+\pi^{\nu?}_{k} A_{\mu? j}$);
distribute(s3)
substitute(s3,$A_{\mu? j}\pi^{\nu?}_{k} -> i\delta^{\nu?}_{\mu?} \delta_{j k}+\pi^{\nu?}_{k} A_{\mu? j}$);
distribute(s3)
sort_product(s3)
rename_dummies(s3);
sort_product(s3);
substitute(s3,$D_{j l \mu}\pi^{\mu}_{l} -> \Pi_{j}, \pi^{\mu}_{l} D_{j l \mu} -> \Pi_{j}$);
substitute(s3,$D_{j k \mu}\pi^{\mu}_{l} f_{j1 k l} -> \Pi_{l} f_{j1 j l}$);
#substitute(s3,$D_{j l \mu}\pi^{\mu}_{l} -> \Pi_{j}, \pi^{\mu}_{l}D_{j l \mu} -> \Pi_{j}$);
canonicalise(s3);
sort_product(s3);
substitute(s3,$f_{j k l} f_{j2 j3 l} -> f_{j2 l k} f_{j3 j l}+f_{j3 l k} f_{j j2 l}$);
#substitute(s3,$D_{l j \mu} -> -D_{j l \mu}$);
#substitute(s3,$\Pi^{\mu}_{l}\partial_{l j \mu} -> -\Pi_{j}$);
# ===== cell 3 (Einstein-Hilbert action) =====
#\epsilon_{\alpha \beta \mu \nu}::EpsilonTensor(delta=\delta^{\mu}_{\nu}, metric=g_{\mu \nu});
#\epsilon^{a b c j}::EpsilonTensor(delta=\delta^{a}_{b}, metric=\eta_{a b});
ex:= \int{e R}{x};
test1:= 1111.
test2:= 2222.
test3:= 3333.
test4:= 4444.
test5:= 5555.
#ex:=e_{\nu}^{a}e^{\alpha4}_{c} \eta_{a a1} \eta_{b a2} e^{\mu}_{j} e^{\alpha}_{l} \eta^{a1 c}  e_{\mu}^{k};
#ex:=\partial_{\mu}{ 1/(e) };
substitute(ex,$R -> g^{\mu \nu} R_{\mu \nu} $,repeat=True)
substitute(ex,$R_{\mu \nu} -> R^{\alpha}_{\mu \alpha \nu}$,repeat=True)
substitute(ex,$R^{\alpha}_{\beta \mu \nu} -> e^{\alpha}_{a} e_{\beta}^{b}\partial_{\mu}{\omega^{a}_{\nu b}}-e^{\alpha}_{a} e_{\beta}^{b}\partial_{\nu}{\omega^{a}_{\mu b}}+e^{\alpha}_{a} e_{\beta}^{b}\omega^{a}_{\mu c}\omega^{c}_{\nu b}-e^{\alpha}_{a} e_{\beta}^{b}\omega^{a}_{\nu c}\omega^{c}_{\mu b}$,repeat=True)
distribute(ex)
rename_dummies(ex)
substitute(ex,$\omega^{a}_{\mu b} -> 1/2 \eta^{a c} e^{\nu}_{c} \eta_{b k}\partial_{\mu}{e^{k}_{\nu}} - 1/2 \eta^{a c} e^{\nu}_{c} \eta_{b k}\partial_{\nu}{e^{k}_{\mu}} - 1/2 e^{\nu}_{b}\partial_{\mu}{e^{a}_{\nu}} + 1/2 e^{\nu}_{b}\partial_{\nu}{e^{a}_{\mu}} - 1/2 \eta^{a c} e^{\alpha}_{c} e^{j}_{\mu} \eta_{j k} e^{\beta}_{b}\partial_{\alpha}{e^{k}_{\beta}} + 1/2 \eta^{a c} e^{\alpha}_{c} e^{j}_{\mu} \eta_{j k} e^{\beta}_{b}\partial_{\beta}{e^{k}_{\alpha}}$,repeat=True)
substitute(ex,$g^{\mu \nu} -> e^{\mu}_{a} e^{\nu}_{b} \eta^{a b}$,repeat=True)
distribute(ex)
rename_dummies(ex)
product_rule(ex)
unwrap(ex)
distribute(ex)
rename_dummies(ex);
#substitute(ex, $\partial_{\mu \nu}{e_{\alpha}^{a}} -> \partial_{\mu}{\partial_{\nu}{e_{\alpha}^{a}}}$)
integrate_by_parts(ex, $\partial_{\nu}{e_{\alpha}^{a}}$)
ex1 = ex[0];
# ===== TEGR / teleparallel form (book.tex's torsion scalar) =====
# ex1 is the Einstein-Hilbert action density eR in the vielbein.
# book.tex's teleparallel (TEGR) Lagrangian density is
#   L ≈ e ( T_{ab}^b T^{ac}_c - 1/2 T_{abc} T^{acb} - 1/4 T_{abc} T^{abc} )
# with the torsion T_{abc} = X_{abc} - X_{bac} built from the connection
# density X (book.tex's e_{abc}). This equals eR up to a total divergence
# (book.tex's 'up to a divergence term' — the standard TEGR identity).
X_{a b c}::Symmetric.
t0_tegr := e ( T_{a b}^{b} T^{a c}_{c} - 1/2 T_{a b c} T^{a c b} - 1/4 T_{a b c} T^{a b c} ).
T_{a b c}::TableauSymmetry(shape={1,1}, indices={0,1}).
substitute(t0_tegr, $ T_{a b c} -> X_{a b c} - X_{b a c} $, repeat=True)
substitute(t0_tegr, $ T^{a b c} -> X^{a b c} - X^{b a c} $, repeat=True)
substitute(t0_tegr, $ T_{a b}^{b} -> X_{a b}^{b} - X_{b a}^{b} $, repeat=True)
substitute(t0_tegr, $ T^{a c}_{c} -> X^{a c}_{c} - X^{c a}_{c} $, repeat=True)
distribute(t0_tegr)
rename_dummies(t0_tegr)
