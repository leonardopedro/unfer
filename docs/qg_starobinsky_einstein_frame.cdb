# THE MISSING LINK in the QG R² chain: Jordan -> Einstein frame.
#
# The sibling modules stop at the JORDAN-frame scalar-tensor form
#     f(R) = (M²/2)ψR − U(ψ),   ψ = 1 + 4αR/M²,   U(ψ) = (M⁴/16α)(ψ−1)²
# (docs/qg_starobinsky_hamiltonian.cdb, action_R2_check / scalaron_check;
#  docs/qg_starobinsky_vielbein_hamiltonian.cdb, H_final_st).  The proofs then use
# the EINSTEIN-frame potential
#     starobinskyV M α φ = M⁴/(16α)·(1 − e^{−√(2/3)·φ/M})²
# (timepiece/BookProof/ChapterStarobinskyPotential.lean:95).  Neither sibling
# module derives that closed form from U(ψ); this module does, so the identity
# the proofs rely on is certified symbolically instead of asserted.
#
# The two steps of the chain, both checked here:
#
#   (1) CONFORMAL WEIGHT OF THE POTENTIAL.  With the Jordan/Einstein metrics
#       related by g = ψ g̃ (ψ the Jordan scalar), the measure scales by
#       √(−g) = ψ² √(−g̃) in d = 4 (from det(ψg̃) = ψ⁴ det g̃), so the potential
#       density √(−g) U(ψ) = √(−g̃) ψ² U(ψ) gives the Einstein-frame potential
#       V(φ) = U(ψ)/ψ² = (M⁴/16α)(1 − 1/ψ)² — manifestly a square.
#
#   (2) FIELD NORMALIZATION.  The Brans–Dicke ω = 0 conformal kinetic term
#       (from the transformation of R) is (3/2)(∂lnψ)² with the scalar
#       multiplying R; with the (M²/2) factor this is (3M²/4)(∂lnψ)², which is
#       the canonical ½(∂φ)² for φ = √(3/2)·M·lnψ — i.e. ψ = e^{√(2/3)φ/M}.
#       Substituting that into V = U/ψ² gives exactly starobinskyV.
#
# Run: cadabra2-cli -q -n <this file>          (exit 0)
# Every *_check below reduces to 0 except Vplat_check, which reduces to the
# plateau value M⁴/(16α) it is meant to test.
#
# GOTCHA (same engine as the siblings): Cadabra keeps negative powers
# factored — `a**(-2)` is carried as `(a)**(-1) (a)**(-1)` — and the insertion
# macro `@(name)` mis-resolves underscored names, so all inlining here is done
# on un-underscored expressions or by writing the expression out.

{\psi, \phi, M, \alpha, x, sqrtg, sqrtgt}::Commuting.

# ===== 1. the conformal weight of the potential =====
# √(−g) = ψ² √(−g̃)  <=>  the potential term picks up ψ^(-2):
#   √(−g) U(ψ) = √(−g̃) ψ² U(ψ)  ⟹  V = U(ψ)/ψ².
measure_check := sqrtg - \psi**2 sqrtgt.
substitute(measure_check, $ sqrtg -> \psi**2 sqrtgt $, repeat=True);
distribute(measure_check);
canonicalise(measure_check);
collect_terms(measure_check);

# U(ψ)/ψ² = (M⁴/16α)(1 − 1/ψ)², in the ψ²-cleared form (multiply by ψ² > 0):
#   (ψ−1)² = (1 − ψ⁻¹)² ψ².
Vweight_check := (\psi - 1)**2 - (1 - \psi**(-1))**2 \psi**2.
expand(Vweight_check);
expand_power(Vweight_check);
distribute(Vweight_check);
sort_product(Vweight_check);
substitute(Vweight_check, $ (\psi)**(-2) \psi \psi -> 1 $, repeat=True);
substitute(Vweight_check, $ (\psi)**(-1) \psi \psi -> \psi $, repeat=True);
substitute(Vweight_check, $ (\psi)**(-1) (\psi)**(-1) -> (\psi)**(-2) $, repeat=True);
substitute(Vweight_check, $ \psi (\psi)**(-1) -> 1 $, repeat=True);
substitute(Vweight_check, $ (\psi)**(-1) \psi -> 1 $, repeat=True);
canonicalise(Vweight_check);
collect_terms(Vweight_check);

# ===== 2. the field redefinition ψ = e^{x}, x = √(2/3) φ/M =====
x := \sqrt{2/3} \phi / M.

# (1 − 1/ψ)² at ψ = e^{x}  ==  (1 − e^{−x})²  ->  0.
closed_check := (M^4/(16 \alpha)) (1 - \psi**(-1))**2
                - (M^4/(16 \alpha)) (1 - \exp(-x))**2.
substitute(closed_check, $ \psi**(-1) -> \exp(-x) $, repeat=True);
substitute(closed_check, $ \psi -> \exp(x) $, repeat=True);
expand(closed_check);
expand_power(closed_check);
distribute(closed_check);
collect_factors(closed_check);
canonicalise(closed_check);
collect_terms(closed_check);

# The closed form is *literally* starobinskyV of the Lean proofs (same M, α, φ):
Vphi_check := (M^4/(16 \alpha)) (1 - \exp(-\sqrt{2/3} \phi/M))**2
              - (M^4/(16 \alpha)) (1 - \exp(-x))**2.
substitute(Vphi_check, $ x -> \sqrt{2/3} \phi/M $, repeat=True);
distribute(Vphi_check);
canonicalise(Vphi_check);
collect_terms(Vphi_check);

# ===== 3. the kinetic normalization (why √(2/3), not something else) =====
# √(2/3)² = 2/3, and the inverse normalization √(3/2)·√(2/3) = 1.
sqrt_check := \sqrt{2/3}**2 - 2/3.
canonicalise(sqrt_check);
collect_terms(sqrt_check);

norm_check := \sqrt{3/2} \sqrt{2/3} - 1.
substitute(norm_check, $ \sqrt{3/2} \sqrt{2/3} -> 1 $, repeat=True);
canonicalise(norm_check);
collect_terms(norm_check);

# Brans–Dicke ω = 0 conformal kinetic: (3/2)(d lnψ)², times M²/2, becomes the
# canonical ½(dφ)² for lnψ = √(2/3) φ/M:
#   (3M²/4)·(2/(3M²)) = 1/2.
kin_check := (3/4) M**2 (2/(3 M**2)) - (1/2).
expand(kin_check);
expand_power(kin_check);
distribute(kin_check);
sort_product(kin_check);
substitute(kin_check, $ M M -> M^{2} $, repeat=True);
substitute(kin_check, $ (M)**(-1) (M)**(-1) -> (M)**(-2) $, repeat=True);
substitute(kin_check, $ M^{2} (M)**(-2) -> 1 $, repeat=True);
substitute(kin_check, $ (M)**(-2) M^{2} -> 1 $, repeat=True);
canonicalise(kin_check);
collect_terms(kin_check);

# ===== 4. the potential's own endpoints (cross-check of the closed form) =====
# Vacuum: V(0) = 0 (proved as starobinskyV_zero in Lean).
Vzero_check := (M^4/(16 \alpha)) (1 - \exp(-\sqrt{2/3} \phi/M))**2.
substitute(Vzero_check, $ \phi -> 0 $, repeat=True);
substitute(Vzero_check, $ \exp(0) -> 1 $, repeat=True);
canonicalise(Vzero_check);
collect_terms(Vzero_check);

# Plateau: as φ → +∞, e^{−√(2/3)φ/M} → 0, V → M⁴/(16α)
# (proved as starobinskyV_tendsto_plateau in Lean).  NOT zero — the plateau value.
Vplat_check := (M^4/(16 \alpha)) (1 - \exp(-\sqrt{2/3} \phi/M))**2.
substitute(Vplat_check, $ \exp(-\sqrt{2/3} \phi/M) -> 0 $, repeat=True);
canonicalise(Vplat_check);
collect_terms(Vplat_check);

# Small-field quadratic term -> the scalaron mass: V ≈ (M⁴/16α) x², so
# ½m² = (M⁴/16α)(2/(3M²)) = M²/(24α), i.e. m² = M²/(12α).
# With the standard normalization α = M²/(12m²) this gives m = M, the naming of
# the parameter in f(R) = (M²/2)R + αR².
m2_check := 2 (M^4/(16 \alpha)) (2/(3 M**2)) - M**2/(12 \alpha).
expand(m2_check);
expand_power(m2_check);
distribute(m2_check);
sort_product(m2_check);
substitute(m2_check, $ (M)**(-1) (M)**(-1) -> (M)**(-2) $, repeat=True);
substitute(m2_check, $ M M -> M^{2} $, repeat=True);
substitute(m2_check, $ M^{4} (M)**(-2) -> M^{2} $, repeat=True);
substitute(m2_check, $ \alpha (\alpha)**(-1) -> 1 $, repeat=True);
canonicalise(m2_check);
collect_terms(m2_check);
