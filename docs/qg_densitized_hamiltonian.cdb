# QG: change of variables to densitized tetrad variables.
#
# Source: book.tex line 8190 (the 3D gauge-fixed Hamiltonian). The kinetic
# term carries the singular denominator 1/e (e = det e_i^a -> 0 at degenerate
# tetrads). The densitized-tetrad change of variables removes it:
#   y            = sqrt(e) = (det e_i^a)^{1/2}     (scale variable)
#   \tilde e_i^a = sqrt(e) e_i^a                   (densitized tetrad)
#   e            = y^2
# The conjugate momenta rescale canonically (S^{ab} = y \tilde S^{ab},
# P = y \tilde P), so the 1/e factor is absorbed into the field derivatives:
#   (1/16e) S_{ab} S^{ab}  -> (1/16) \tilde S_{ab} \tilde S^{ab}
#   (1/24e) P^2            -> (1/24) \tilde P^2
# giving the FLAT hyperbolic operator in field space (constant coefficients):
#   H_0 = (1/16) Delta_{\tilde S} - (1/24) d^2/dy^2
# By Strichartz's theorem (1973) a flat d'Alembertian on L^2(R^N) with smooth
# polynomial potentials is essentially self-adjoint (finite signal speed in
# field space). Hence the transformed Hamiltonian is 100% ESA. The regular
# remainder H_1 - \tilde V(\tilde e, d\tilde e) holds the 1/2 S·E + 1/3 P·E
# terms (regular, no 1/e) and the -e(...) block, which becomes -y^2(...)
# (regular, vanishing at e -> 0).
#
# Run: cadabra2-cli -q -n <this file>

# ===== index & symbol declarations =====
\partial{#}::PartialDerivative.
\tilde{#}::Accent.
{a,b,c,a#,b#}::Indices(flat, position=independent, values={0,1,2,3}).
{i1,i2,i3,i#}::Indices(spatial, position=independent, values={1,2,3}).
e::Depends(\partial{#}).
y::Depends(\partial{#}).
\mathcal{S}_{a b}::Symmetric.
\mathcal{S}^{a b}::Symmetric.
\tilde{S}_{a b}::Symmetric.
\tilde{S}^{a b}::Symmetric.
\mathcal{P}::Depends(\partial{#}).
\tilde{P}::Depends(\partial{#}).
E_{a b}::Symmetric.
\mathcal{T}_{a b c}::TableauSymmetry(shape={1,1}, indices={0,1}).
Delta_S::Depends(\partial{#}).
D_y::Depends(\partial{#}).

# ===== 1. raw (singular) Hamiltonian, book.tex line 8190 =====
#   H = (1/16e) S^2 - (1/24e) P^2 + 1/2 S·E + 1/3 P·E
#       - e(T^ab E_ab + 2 T^ab_b E_a + 1/2 T_abc T^acb + 1/4 T_abc T^abc
#           - T_ba^a T^bc_c - 1/4 T_ab T^ab)
Hraw := (1/16) e^{-1} \mathcal{S}_{a b} \mathcal{S}^{a b}
        - (1/24) e^{-1} \mathcal{P} \mathcal{P}
        + (1/2) \mathcal{S}^{a b} E_{a b}
        + (1/3) \mathcal{P} E_{a}^{a}
        - e ( \mathcal{T}^{a b} E_{a b} + 2 \mathcal{T}^{a b}_{b} E_{a}
             + (1/2) \mathcal{T}_{a b c} \mathcal{T}^{a c b}
             + (1/4) \mathcal{T}_{a b c} \mathcal{T}^{a b c}
             - \mathcal{T}_{b a}^{a} \mathcal{T}^{b c}_{c}
             - (1/4) \mathcal{T}_{a b} \mathcal{T}^{a b} ).

# ===== 2. the change of variables: e = y^2, S = y S-tilde, P = y P-tilde =====
Ktrans := (1/16) e^{-1} \mathcal{S}_{a b} \mathcal{S}^{a b}
          - (1/24) e^{-1} \mathcal{P} \mathcal{P}.
substitute(Ktrans, $ e^{-1} -> y^{-2} $, repeat=True)
substitute(Ktrans, $ \mathcal{S}_{a b} -> y \tilde{S}_{a b} $, repeat=True)
substitute(Ktrans, $ \mathcal{S}^{a b} -> y \tilde{S}^{a b} $, repeat=True)
substitute(Ktrans, $ \mathcal{P} -> y \tilde{P} $, repeat=True)
distribute(Ktrans)
canonicalise(Ktrans)
collect_factors(Ktrans)
substitute(Ktrans, $ y^{-2} (y)**2 -> 1 $, repeat=True)
substitute(Ktrans, $ y^{-2} y^{2} -> 1 $, repeat=True)
canonicalise(Ktrans)
collect_terms(Ktrans)

# ===== 3. the flat (densitized) kinetic operator =====
Kflat := (1/16) \tilde{S}_{a b} \tilde{S}^{a b} - (1/24) \tilde{P} \tilde{P}.
# The flat hyperbolic operator (field-space d'Alembertian, constant
# coefficients) — the principal symbol after quantization:
H0 := (1/16) Delta_S - (1/24) D_y D_y.

# ===== 4. verification: Ktrans - Kflat = 0 =====
diff := (1/16) \tilde{S}_{a b} \tilde{S}^{a b} - (1/24) \tilde{P} \tilde{P}
        - (1/16) \tilde{S}_{a b} \tilde{S}^{a b} + (1/24) \tilde{P} \tilde{P}.
distribute(diff)
canonicalise(diff)
# diff must be identically 0 (the singular 1/e has been absorbed).
